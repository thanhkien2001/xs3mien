<script>
    // Handle province selection to change URL
    (function() {
        const selectEl = document.querySelector('.js-select-other-day');
        if (!selectEl) return;

        selectEl.addEventListener('change', function(e) {
            const value = e.target.value.trim();

            // If it's a URL (miền), redirect
            if (value.startsWith('/')) {
                window.location.href = value;
                return;
            }

            // If it's a province code, redirect to province URL
            if (value && value.startsWith('xs')) {
                window.location.href = '/quay-thu-' + value + '.html';
            }
        });
    })();
</script>
