function getWeekdayUrl($region, $weekdaySlug)
{
    $regionLower = strtolower($region);
    $regionUrls = [
        'xsmb' => "/xsmb-{$weekdaySlug}-ket-qua-xo-so-mien-bac.html",
        'xsmn' => "/xsmn-{$weekdaySlug}-ket-qua-xo-so-mien-nam.html",
        'xsmt' => "/xsmt-{$weekdaySlug}-ket-qua-xo-so-mien-trung.html",
    ];
    return $regionUrls[$regionLower] ?? $regionUrls['xsmb'];
}

function getDateUrl($region, $dateObj)
{
    $regionLower = strtolower($region);
    $dayMonth = $dateObj->format('j-n');
    $fullDate = $dateObj->format('j-n-Y');

    $regionUrls = [
        'xsmb' => "/xsmb-{$dayMonth}-ket-qua-xo-so-mien-bac-ngay-{$fullDate}.html",
        'xsmn' => "/xsmn-{$dayMonth}-ket-qua-xo-so-mien-nam-ngay-{$fullDate}.html",
        'xsmt' => "/xsmt-{$dayMonth}-ket-qua-xo-so-mien-trung-ngay-{$fullDate}.html",
    ];
    return $regionUrls[$regionLower] ?? $regionUrls['xsmb'];
}
