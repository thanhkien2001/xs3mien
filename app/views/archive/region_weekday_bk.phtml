            <?php
            $currentPage = (int)$page;
            $totalPages = isset($totalPages) ? (int)$totalPages : 10;
            function generatePageUrl($baseUrl, $pageNum)
            {
                $pageNum = max(1, $pageNum);
                $url = preg_replace('/[?&]page=\d+/', '', $baseUrl);
                return $url . (strpos($url, '?') === false ? '?' : '&') . 'page=' . $pageNum;
            }
            if ($nextUrl && $nextUrl !== '#') {
                $baseUrl = preg_replace('/[?&]page=\d+/', '', $nextUrl);
            } elseif ($prevUrl && $prevUrl !== '#') {
                $baseUrl = preg_replace('/[?&]page=\d+/', '', $prevUrl);
            }

            $firstUrl = generatePageUrl($baseUrl, 1);
            $lastUrl = generatePageUrl($baseUrl, $totalPages);

            $maxPagesToShow = 6;
            $startPage = max(1, $currentPage - floor($maxPagesToShow / 2));
            $endPage = min($totalPages, $startPage + $maxPagesToShow - 1);

            if ($endPage - $startPage + 1 < $maxPagesToShow) {
                $startPage = max(1, $endPage - $maxPagesToShow + 1);
            }
            ?>
            <nav aria-label="pagination">
                <ul class="comp-pagination util-justify-center util-mt-3">
                    <li class="comp-page-item <?= $currentPage == 1 ? 'disabled' : '' ?>">
                        <a class="comp-page-link" href="<?= $firstUrl ?>" aria-label="First">
                            <span aria-hidden="true">« Đầu</span>
                        </a>
                    </li>
                    <li class="comp-page-item <?= $prevUrl ? '' : 'disabled' ?>">
                        <a class="comp-page-link" href="<?= $prevUrl ?: '#' ?>" aria-label="Previous">
                            <span aria-hidden="true">‹ Trước</span>
                        </a>
                    </li>

                    <?php for ($p = $startPage; $p <= $endPage; $p++): ?>
                        <li class="comp-page-item <?= $p == $currentPage ? 'is-active' : '' ?>">
                            <a class="comp-page-link" href="<?= generatePageUrl($baseUrl, $p) ?>"><?= $p ?></a>
                        </li>
                    <?php endfor; ?>

                    <li class="comp-page-item <?= $currentPage == $totalPages ? 'disabled' : '' ?>">
                        <a class="comp-page-link" href="<?= $nextUrl ?: '#' ?>" aria-label="Next">
                            <span aria-hidden="true">Sau ›</span>
                        </a>
                    </li>
                    <li class="comp-page-item <?= $currentPage == $totalPages ? 'disabled' : '' ?>">
                        <a class="comp-page-link" href="<?= $lastUrl ?>" aria-label="Last">
                            <span aria-hidden="true">Cuối »</span>
                        </a>
                    </li>
                </ul>
            </nav>

