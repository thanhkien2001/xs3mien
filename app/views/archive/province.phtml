// Helper function to get weekday slug from date
function getWeekdaySlug($dateObj)
{
    $dow = (int)$dateObj->format('N'); // 1=Monday, 7=Sunday
    $slugs = [
        1 => 'thu-2',
        2 => 'thu-3',
        3 => 'thu-4',
        4 => 'thu-5',
        5 => 'thu-6',
        6 => 'thu-7',
        7 => 'chu-nhat'
    ];
    return $slugs[$dow] ?? 'thu-2';
}

// Helper function to get weekday text
function getWeekdayText($dateObj)
{
    $dow = (int)$dateObj->format('N');
    $texts = [
        1 => 'thứ 2',
        2 => 'thứ 3',
        3 => 'thứ 4',
        4 => 'thứ 5',
        5 => 'thứ 6',
        6 => 'thứ 7',
        7 => 'chủ nhật'
    ];
    return $texts[$dow] ?? 'thứ 2';
}

