<script>
    // Helper function để đợi jQuery (định nghĩa trước)
    function waitForJQuery(callback, maxWait) {
        maxWait = maxWait || 1000; // Max 1 second (giảm từ 5s xuống 1s)
        var startTime = Date.now();
        var attempts = 0;
        var maxAttempts = 20; // Tối đa 20 lần check (20 * 50ms = 1s)
        
        function check() {
            attempts++;
            var elapsed = Date.now() - startTime;
            
            if (typeof jQuery !== 'undefined') {
                callback(jQuery);
                return;
            } else if (typeof window.$ !== 'undefined' && window.$.fn && window.$.fn.jquery) {
                callback(window.$);
                return;
            }
            
            // Nếu chưa hết thời gian và chưa vượt quá số lần thử
            if (elapsed < maxWait && attempts < maxAttempts) {
                setTimeout(check, 50);
            } else {
                // Fallback: pass null để callback dùng vanilla JS
                if (typeof callback === 'function') {
                    callback(null);
                }
            }
        }
        
        check();
    }

    // Handler function được gọi từ onclick (inline)
    function handleSoiCauClick(element, positionsStr) {
        
        if (!positionsStr || positionsStr === '' || positionsStr === '0') {
            alert('Số này chưa có dữ liệu vị trí để highlight');
            return false;
        }
        
        // Kiểm tra jQuery có sẵn ngay không
        var $ = (typeof jQuery !== 'undefined') ? jQuery : (typeof window.$ !== 'undefined' && window.$.fn && window.$.fn.jquery) ? window.$ : null;
        
        if ($) {
            // jQuery có sẵn, dùng ngay
            var $el = $(element);
            
            // Remove previous highlights
            $('.block-number, .soicau_mb, .item-tk-cau-icon').removeClass('highlight');
            
            // Highlight element được click
            $el.addClass('highlight');
            if ($el.hasClass('item-tk-cau-icon')) {
                $el.find('.soicau_mb').addClass('highlight');
            }
            
            // Gọi highlightAndScroll với jQuery
            if (typeof highlightAndScroll === 'function') {
                highlightAndScroll(positionsStr, true);
            } else {
            }
        } else {
            // jQuery chưa có, dùng vanilla JS ngay hoặc đợi một chút
            waitForJQuery(function($) {
                if ($) {
                    var $el = $(element);
                    $('.block-number, .soicau_mb, .item-tk-cau-icon').removeClass('highlight');
                    $el.addClass('highlight');
                    if ($el.hasClass('item-tk-cau-icon')) {
                        $el.find('.soicau_mb').addClass('highlight');
                    }
                    if (typeof highlightAndScroll === 'function') {
                        highlightAndScroll(positionsStr, true);
                    }
                } else {
                    highlightAndScrollVanilla(element, positionsStr);
                }
            }, 500);
        }
        
        return false;
    }
    
    // Fallback function với vanilla JS
    function highlightAndScrollVanilla(element, positionsStr) {
        
        // Remove previous highlights
        document.querySelectorAll('.block-number, .soicau_mb, .item-tk-cau-icon').forEach(function(el) {
            el.classList.remove('highlight');
        });
        
        // Highlight element
        element.classList.add('highlight');
        if (element.classList.contains('item-tk-cau-icon')) {
            var soicauMb = element.querySelector('.soicau_mb');
            if (soicauMb) soicauMb.classList.add('highlight');
        }
        
        // Parse positions
        var positions = positionsStr.toString().split(',').map(function(p) {
            return parseInt(p.trim());
        }).filter(function(p) {
            return !isNaN(p) && p > 0;
        });
        
        // Remove previous result highlights
        document.querySelectorAll('.result-number').forEach(function(el) {
            el.classList.remove('highlight-result');
        });
        
        // Scroll đến section
        var resultsSection = document.getElementById('xsmb-results-section');
        if (!resultsSection) {
            resultsSection = document.querySelector('.col-12.mt-4');
        }
        if (resultsSection) {
            resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            
            // Highlight numbers after scroll (giảm thời gian đợi)
            setTimeout(function() {
                highlightResultNumbersVanilla(positions);
            }, 400); // Giảm từ 600ms xuống 400ms
        } else {
            // Nếu không tìm thấy section, highlight ngay
            highlightResultNumbersVanilla(positions);
        }
    }

    // Định nghĩa functions trước khi dùng (global scope)
    /**
     * Function để highlight và scroll đến bảng kết quả
     * @param {string} positionsStr - Chuỗi positions (ví dụ: "71,72")
     * @param {boolean} keepElementHighlight - Giữ highlight của element được click (default: true)
     */
    function highlightAndScroll(positionsStr, keepElementHighlight) {
        
        if (keepElementHighlight === undefined) {
            keepElementHighlight = true;
        }
        
        if (!positionsStr || positionsStr === '' || positionsStr === '0') {
            return;
        }
        
        // Parse positions từ string "71,72" thành array [71, 72]
        var positions = positionsStr.toString().split(',').map(function(p) {
            return parseInt(p.trim());
        }).filter(function(p) {
            return !isNaN(p) && p > 0;
        });
        
        if (positions.length === 0) {
            return;
        }
        
        
        // Kiểm tra jQuery có sẵn ngay không
        var $ = (typeof jQuery !== 'undefined') ? jQuery : (typeof window.$ !== 'undefined' && window.$.fn && window.$.fn.jquery) ? window.$ : null;
        
        if ($) {
            // jQuery có sẵn, dùng ngay
            executeHighlightAndScroll($, positions, keepElementHighlight);
        } else {
            // Đợi jQuery load xong (tối đa 500ms)
            waitForJQuery(function($) {
                if ($) {
                    executeHighlightAndScroll($, positions, keepElementHighlight);
                } else {
                    // Fallback với vanilla JS
                    var resultsSection = document.getElementById('xsmb-results-section') || document.querySelector('.col-12.mt-4');
                    if (resultsSection) {
                        resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        setTimeout(function() {
                            highlightResultNumbersVanilla(positions);
                        }, 600);
                    }
                }
            }, 500);
        }
        
        function executeHighlightAndScroll($, positions, keepElementHighlight) {
            // Remove previous highlights (nhưng giữ highlight của element được click)
            if (!keepElementHighlight) {
                $('.block-number, .soicau_mb, .item-tk-cau-icon').removeClass('highlight');
            }
            $('.result-number').removeClass('highlight-result');
            
            // Scroll đến phần bảng kết quả (smooth scroll)
            var resultsSection = $('#xsmb-results-section');
            if (!resultsSection.length) {
                resultsSection = $('.col-12.mt-4').first();
            }
            
            
            if (resultsSection.length) {
                var scrollOffset = resultsSection.offset().top - 100;
                $('html, body').animate({
                    scrollTop: scrollOffset
                }, 400, function() { // Giảm từ 500ms xuống 400ms
                    // Sau khi scroll xong, highlight các số
                    highlightResultNumbers(positions);
                });
            } else {
                // Nếu không tìm thấy section, highlight ngay
                highlightResultNumbers(positions);
            }
        }
    }
    
    /**
     * Highlight các số trong bảng kết quả dựa trên positions (dùng jQuery)
     */
    function highlightResultNumbers(positions) {
        
        // Kiểm tra jQuery có sẵn ngay không
        var $ = (typeof jQuery !== 'undefined') ? jQuery : (typeof window.$ !== 'undefined' && window.$.fn && window.$.fn.jquery) ? window.$ : null;
        
        if ($) {
            executeHighlightResultNumbers($, positions);
        } else {
            waitForJQuery(function($) {
                if ($) {
                    executeHighlightResultNumbers($, positions);
                } else {
                    highlightResultNumbersVanilla(positions);
                }
            }, 300); // Chỉ đợi 300ms
        }
        
        function executeHighlightResultNumbers($, positions) {
            var highlightedCount = 0;
            var totalNumbers = $('.result-number').length;
            
            $('.result-number').each(function() {
                var position = parseInt($(this).data('position'));
                if (!isNaN(position) && positions.indexOf(position) !== -1) {
                    $(this).addClass('highlight-result');
                    highlightedCount++;
                    
                    // Scroll đến số được highlight nếu cần
                    var $resultArticle = $(this).closest('article');
                    if ($resultArticle.length) {
                        var articleTop = $resultArticle.offset().top;
                        var currentScroll = $(window).scrollTop();
                        var windowHeight = $(window).height();
                        
                        // Nếu số nằm ngoài viewport, scroll đến nó
                        if (articleTop < currentScroll || articleTop > currentScroll + windowHeight) {
                            $('html, body').animate({
                                scrollTop: articleTop - 150
                            }, 200); // Giảm từ 300ms xuống 200ms
                        }
                    }
                }
            });
        }
    }
    
    /**
     * Highlight các số trong bảng kết quả dựa trên positions (dùng vanilla JS)
     */
    function highlightResultNumbersVanilla(positions) {
        var resultNumbers = document.querySelectorAll('.result-number');
        var highlightedCount = 0;
        
        resultNumbers.forEach(function(el) {
            var position = parseInt(el.getAttribute('data-position'));
            if (!isNaN(position) && positions.indexOf(position) !== -1) {
                el.classList.add('highlight-result');
                highlightedCount++;
            }
        });
        
    }

    $(document).ready(function() {
        // Initialize datepicker
        $('#dateEnd').datepicker({
            format: 'dd/mm/yyyy',
            language: 'vi',
            autoclose: true,
            todayHighlight: true,
            endDate: new Date()
        });

        // Plus/Minus buttons
        $('#btn-plus').on('click', function() {
            var val = parseInt($('#range-day').val()) || 3;
            if (val < 5) {
                $('#range-day').val(val + 1);
            }
        });

        $('#btn-minus').on('click', function() {
            var val = parseInt($('#range-day').val()) || 3;
            if (val > 3) {
                $('#range-day').val(val - 1);
            }
        });

        // Initialize tooltips
        $('[data-toggle="tooltip"]').tooltip();
        
        // Event delegation cho các số trong biên độ và bảng cầu
        // Lắng nghe tất cả clicks trên .block-number và .item-tk-cau-icon
        $(document).on('click', '.block-number, .item-tk-cau-icon', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            var $el = $(this);
            var positionsStr = $el.attr('data-positions') || '';
            
            // Nếu không có trên element, tìm trong children
            if (!positionsStr) {
                positionsStr = $el.find('[data-positions]').first().attr('data-positions') || '';
            }
            
            // Nếu không có, tìm trong parent
            if (!positionsStr) {
                positionsStr = $el.closest('[data-positions]').attr('data-positions') || '';
            }
            
            // Chỉ xử lý nếu có positions và không rỗng
            if (positionsStr && positionsStr.trim() !== '' && positionsStr !== '0') {
                // Remove previous highlights
                $('.block-number, .soicau_mb, .item-tk-cau-icon').removeClass('highlight');
                
                // Highlight element được click
                $el.addClass('highlight');
                if ($el.hasClass('item-tk-cau-icon')) {
                    $el.find('.soicau_mb').addClass('highlight');
                }
                
                // Scroll và highlight trong bảng kết quả
                highlightAndScroll(positionsStr.trim(), true);
            } else {
                alert('Số này chưa có dữ liệu vị trí để highlight');
            }
        });
        
    });

    // Function to highlight positions in loto table (backward compatibility)
    function setcolortoloto(element, ...positions) {
        // Lấy positions từ data-positions attribute
        var $el = $(element);
        var positionsStr = $el.attr('data-positions') || 
                         $el.closest('[data-positions]').attr('data-positions') || '';
        
        // Hoặc từ arguments nếu có
        if (!positionsStr && positions && positions.length > 0) {
            positionsStr = positions.join(',');
        }
        
        if (positionsStr) {
            highlightAndScroll(positionsStr);
        }
    }
</script>

<style>
/* Highlight cho số trong bảng cầu và biên độ */
.block-number.highlight,
.soicau_mb.highlight,
.item-tk-cau-icon.highlight {
    background-color: #ffc107 !important;
    font-weight: bold;
    box-shadow: 0 0 10px rgba(255, 193, 7, 0.5);
}

/* Highlight cho số trong bảng kết quả */
.result-number.highlight-result {
    background-color: #ffc107 !important;
    color: #000 !important;
    font-weight: bold;
    padding: 2px 4px;
    border-radius: 3px;
    box-shadow: 0 0 8px rgba(255, 193, 7, 0.8);
    animation: pulse-highlight 0.6s ease-in-out;
}

@keyframes pulse-highlight {
    0% {
        transform: scale(1);
    }
    50% {
        transform: scale(1.1);
    }
    100% {
        transform: scale(1);
    }
}
</style>
