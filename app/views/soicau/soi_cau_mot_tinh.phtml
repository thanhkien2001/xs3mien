<script>
$(document).ready(function() {
    // Initialize datepicker
    $('#dateEnd').datepicker({
        format: 'dd/mm/yyyy',
        language: 'vi',
        autoclose: true,
        todayHighlight: true,
        endDate: new Date()
    });

    // Plus/Minus buttons
    $('#btn-plus').on('click', function() {
        var val = parseInt($('#range-day').val()) || 2;
        if (val < 4) {
            $('#range-day').val(val + 1);
        }
    });

    $('#btn-minus').on('click', function() {
        var val = parseInt($('#range-day').val()) || 2;
        if (val > 2) {
            $('#range-day').val(val - 1);
        }
    });
});
</script>
                                                        