// Helper functions
function formatDate($dateStr)
{
    $date = is_string($dateStr) ? \DateTime::createFromFormat('d/m/Y', $dateStr) : $dateStr;
    if (!$date)
        return '';

    $dayOfWeek = ['Chủ nhật', 'Thứ hai', 'Thứ ba', 'Thứ tư', 'Thứ năm', 'Thứ sáu', 'Thứ bảy'];
    $dow = $dayOfWeek[$date->format('w')];
    return $dow . ', ' . $date->format('d/m/Y');
}

function formatDateForUrl($dateStr)
{
    $date = is_string($dateStr) ? \DateTime::createFromFormat('d/m/Y', $dateStr) : $dateStr;
    if (!$date)
        return '';
    return $date->format('d-m-Y');
}

function getDayOfWeekInVietnamese($dateStr)
{
    $date = is_string($dateStr) ? \DateTime::createFromFormat('d/m/Y', $dateStr) : $dateStr;
    if (!$date)
        return '';

    $dayOfWeek = ['chủ nhật', 'thứ 2', 'thứ 3', 'thứ 4', 'thứ 5', 'thứ 6', 'thứ 7'];
    return $dayOfWeek[$date->format('w')];
}
