function printCells($items)
{
    if (empty($items)) {
        echo '<span class="util-loading-spinner util-spinner-sm util-text-warning util-fs-6" role="status"></span>';
        return;
    }
    foreach ($items as $n) {
        echo '<div class="lottery-number-item">' . htmlspecialchars((string)$n, ENT_QUOTES, 'UTF-8') . '</div>';
    }
}
