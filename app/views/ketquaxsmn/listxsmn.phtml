    function rmAccents(s) {
        return s.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    }

    function toSlugName(name) {
        return rmAccents(name).toLowerCase()
            .replace(/\s+/g, '-').replace(/[^a-z0-9\-]/g, '')
            .replace(/\-+/g, '-').replace(/^\-|\-$/g, '');
    }

    function xsmnHref(d) {
        const slugDateMonth = d => `${pad(d.getDate())}-${pad(d.getMonth()+1)}`;
