            "Hậu Giang": "HG",
            "Sóc Trăng": "ST",
            "Tây Ninh": "TN",
            "Trà Vinh": "TV",
            "Vĩnh Long": "VL",
            "Vũng Tàu": "VT"
        };
        return map[prov] || rmAccents(prov).split(' ').map(w => w[0]).join('').toUpperCase();
    }

    function provTitle(prov, d) {
        return `XS${toAbbr(prov)} ${vnDate(d)} – KQ Xổ Số ${prov} Ngày ${vnDateDashPad2(d).replace(/-/g,'-')}`;
    }

    function getBaseDateFromURL() {
        const m = location.pathname.match(/\/xsmn-(\d{1,2})-(\d{1,2})-ket-qua-xo-so-mien-nam-ngay-(\d{1,2})-(\d{1,2})-(\d{4})\.html/i);
        if (m) {
            const d = +m[3],
                mo = +m[4],
                y = +m[5];
            const dt = new Date(y, mo - 1, d);
            if (!isNaN(dt)) return dt;
        }
        const now = new Date();
        return new Date(now.getFullYear(), now.getMonth(), now.getDate());
    }

    // Cache DOM elements
    const DOM_CACHE = {
        topList: null,
        moreList: null,
        btnMore: null
    };

    const TEMPLATES = {
        cardLI: (href, title, img, desc, isFirst) => `<li class="${isFirst ? 'first' : ''}">
      <a class="util-flex util-shadow-sm util-text-decoration-none util-p-4" href="${href}" title="${title}">
        <img class="comp-thumb-medium util-float-start util-me-3 util-lazy-load"
             src="${DEFAULT_THUMB}" data-src="${img || IMG_COMBINED}" alt="${title}">
        <aside class="util-flex-grow-1">
          <h3 class="util-fs-5-5 util-font-medium util-lh-base util-mb-2">${title}</h3>
          <p class="util-text-body util-line-clamp-2 util-mb-0" style="min-height: 2.5em;">${desc}</p>
        </aside>
      </a>
    </li>`
    };

    function buildCardLI({
        href,
        title,
        img,
        desc,
        isFirst = false
    }) {
        return TEMPLATES.cardLI(href, title, img, desc, isFirst);
    }

    function renderDayBlock(dateObj, {
        into,
        isTop = false
    }) {
        const wd = dateObj.getDay();
        const provinces = SCHEDULE_MN[wd] || [];

        const fragment = document.createDocumentFragment();
        const tempDiv = document.createElement('div');

        const dateStr = vnDate(dateObj);
        const dateDashStr = vnDateDashPad2(dateObj);

        const titleAll = xsmnTitle(dateObj);
        const hrefAll = xsmnHref(dateObj);
        const descAll = `XSMN ${dateStr}, cập nhật KQXS Miền Nam ngày ${dateStr} đầy đủ & chính xác.`;

        let html = buildCardLI({
            href: hrefAll,
            title: titleAll,
            img: IMG_COMBINED,
            desc: descAll,
            isFirst: isTop
        });

        for (let i = 0; i < provinces.length; i++) {
            const prov = provinces[i];
            const title = provTitle(prov, dateObj);
            const href = provHref(prov, dateObj);
            const img = PROV_IMG[prov] || IMG_COMBINED;
            const desc = `XS${toAbbr(prov)} ${dateStr}. KQ xổ số ${prov} ngày ${dateDashStr} cập nhật nhanh từ nhà đài.`;
            html += buildCardLI({
                href,
                title,
                img,
                desc
            });
        }

        tempDiv.innerHTML = html;
        while (tempDiv.firstChild) {
            fragment.appendChild(tempDiv.firstChild);
        }

        into.appendChild(fragment);
    }

    function initLazy() {
        if (window.lozad) {
            lozad('.util-lazy-load').observe();
        } else {
            document.querySelectorAll('img.util-lazy-load[data-src]').forEach(img => {
                img.src = img.dataset.src;
            });
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        // Cache DOM elements once
        DOM_CACHE.topList = document.querySelector('.js-article-listing');
        DOM_CACHE.moreList = document.querySelector('.js-wrap-kqxs-inner');
        DOM_CACHE.btnMore = document.querySelector('.js-load-readmore-kqxs');

        if (!DOM_CACHE.topList || !DOM_CACHE.moreList) return;

        const baseDate = getBaseDateFromURL();

        renderDayBlock(baseDate, {
            into: DOM_CACHE.topList,
            isTop: true
        });

        initLazy();

        let offset = 1;
        let isLoading = false;

        DOM_CACHE.btnMore?.addEventListener('click', () => {
            if (isLoading) return;
            isLoading = true;

            const d = new Date(baseDate);
            d.setDate(baseDate.getDate() - offset);
            offset += 1;

            renderDayBlock(d, {
                into: DOM_CACHE.moreList
            });

            if (window.lozad) {
                const newImages = DOM_CACHE.moreList.querySelectorAll('.util-lazy-load:not([data-loaded])');
                if (newImages.length > 0) {
                    lozad(newImages).observe();
                }
            }

            isLoading = false;
        });
    });
</script>