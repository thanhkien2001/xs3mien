function cellVals($pp, $field)
{
    if (empty($pp['previousResult'])) return [];
    $r = $pp['previousResult'];
    if ($field === 'special_prize' || $field === 'first_prize') {
        $v = (string)($r->{$field} ?? '');
        return $v === '' ? [] : [$v];
    }
    return safeDecode($r->{$field} ?? null);
}

$aggFreq = [];
foreach ($perProvince as $pp) {
    foreach (($pp['frequentNumbers'] ?? []) as $o) {
        $aggFreq[$o->number] = ($aggFreq[$o->number] ?? 0) + (int)$o->count;
    }
}
arsort($aggFreq);
$aggFreqTop = array_slice($aggFreq, 0, 10, true);
$aggFreqMax = !empty($aggFreqTop) ? max($aggFreqTop) : 1;

$aggGan = [];
foreach ($perProvince as $pp) {
    foreach (($pp['ganNumbers'] ?? []) as $g) {
        $n = $g->number;
        $d = (int)$g->days;
        if (!isset($aggGan[$n]) || $d > $aggGan[$n]['days']) {
            $aggGan[$n] = ['days' => $d, 'last' => $g->last_appeared ?? null];
        }
    }
}
uasort($aggGan, function ($a, $b) {
    return $b['days'] <=> $a['days'];
});
$aggGanTop = array_slice($aggGan, 0, 10, true);

$dateGroups = [];
foreach ($perProvince as $pp) {
