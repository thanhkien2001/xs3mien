<script>
    const SCHEDULE_MT = {
        1: ["Dự đoán Huế", "Dự đoán Phú Yên"],
        2: ["Dự đoán Đắk Lắk", "Dự đoán Quảng Nam"],
        3: ["Dự đoán Đà Nẵng", "Dự đoán Khánh Hòa"],
        4: ["Dự đoán Bình Định", "Dự đoán Quảng Bình", "Dự đoán Quảng Trị"],
        5: ["Dự đoán Gia Lai", "Dự đoán Ninh Thuận"],
        6: ["Dự đoán Đà Nẵng", "Dự đoán Đắk Nông", "Dự đoán Quảng Ngãi"],
        0: ["Dự đoán Khánh Hòa", "Dự đoán Kon Tum", "Dự đoán Huế"]
    };

    const PROV_SLUG_MAP = {
        "Huế": "xsh",
        "Phú Yên": "xspy",
        "Đắk Lắk": "xsdlk",
        "Quảng Nam": "xsqn",
        "Đà Nẵng": "xsdn",
        "Khánh Hòa": "xskh",
        "Bình Định": "xsbd",
        "Quảng Bình": "xsqb",
        "Quảng Trị": "xsqt",
        "Gia Lai": "xsgl",
        "Ninh Thuận": "xsnt",
        "Đắk Nông": "xsdnong",
        "Quảng Ngãi": "xsqng",
        "Kon Tum": "xskt"
    };

    function createProvinceUrl(provinceName) {
        // Remove "Dự đoán " prefix to get clean province name
        const cleanName = provinceName.replace(/^Dự đoán /, '');
        const provinceSlug = PROV_SLUG_MAP[cleanName];
        if (!provinceSlug) {
            console.warn(`No slug mapping found for province: ${cleanName}`);
            return '#';
        }
        return `/du-doan-${provinceSlug}.html`;
    }

    function renderTodayProvinces() {
        const now = new Date();
        const dayOfWeek = now.getDay();
        const provinces = SCHEDULE_MT[dayOfWeek] || [];

        const container = document.querySelector('.js-province-today');
        if (!container) return;

        let html = '';
        provinces.forEach(provinceName => {
            const url = createProvinceUrl(provinceName);
            const title = `Dự đoán XSMT ${provinceName}`;
            html += `<li><a class="" title="${title}" href="${url}">${provinceName}</a></li>`;
        });

        container.innerHTML = html;
    }

    document.addEventListener('DOMContentLoaded', () => {
        renderTodayProvinces();
    });
</script>
