<script>
    const SCHEDULE_MN = {
        1: ["Dự đoán Cà Mau", "Dự đoán Hồ Chí Minh", "Dự đoán Đồng Tháp"],
        2: ["Dự đoán Bạc Liêu", "Dự đoán Bến Tre", "Dự đoán Vũng Tàu"],
        3: ["Dự đoán Cần Thơ", "Dự đoán Sóc Trăng", "Dự đoán Đồng Nai"],
        4: ["Dự đoán An Giang", "Dự đoán Bình Thuận", "Dự đoán Tây Ninh"],
        5: ["Dự đoán Bình Dương", "Dự đoán Trà Vinh", "Dự đoán Vĩnh Long"],
        6: ["Dự đoán Bình Phước", "Dự đoán Hậu Giang", "Dự đoán Hồ Chí Minh", "Dự đoán Long An"],
        0: ["Dự đoán Kiên Giang", "Dự đoán Tiền Giang", "Dự đoán Đà Lạt"]
    };

    const PROV_SLUG_MAP = {
        "An Giang": "xsag",
        "Bạc Liêu": "xsblieu",
        "Bến Tre": "xsbtr",
        "Bình Dương": "xsbduong",
        "Bình Phước": "xsbp",
        "Bình Thuận": "xsbthuan",
        "Cà Mau": "xscm",
        "Cần Thơ": "xsct",
        "Đà Lạt": "xsdl",
        "Đồng Nai": "xsdn",
        "Đồng Tháp": "xsdthap",
        "Hậu Giang": "xshg",
        "Hồ Chí Minh": "xshcm",
        "Kiên Giang": "xskg",
        "Long An": "xsla",
        "Sóc Trăng": "xsst",
        "Tây Ninh": "xstn",
        "Tiền Giang": "xstg",
        "Trà Vinh": "xstv",
        "Vĩnh Long": "xsvl",
        "Vũng Tàu": "xsvt"
    };

    function createProvinceUrl(provinceName) {
        const cleanName = provinceName.replace(/^Dự đoán /, '');
        const provinceSlug = PROV_SLUG_MAP[cleanName];
        if (!provinceSlug) {
            console.warn(`No slug mapping found for province: ${cleanName}`);
            return '#';
        }
        return `/du-doan-${provinceSlug}.html`;
    }

    function renderTodayProvinces() {
        const now = new Date();
        const dayOfWeek = now.getDay();
        const provinces = SCHEDULE_MN[dayOfWeek] || [];

        const container = document.querySelector('.js-province-today');
        if (!container) return;

        let html = '';
        provinces.forEach(provinceName => {
            const url = createProvinceUrl(provinceName);
            const cleanName = provinceName.replace(/^Dự đoán /, ''); // ✅ Lấy tên sạch
            const title = `Dự đoán XSMN ${cleanName}`; // ✅ Không bị duplicate
            html += `<li><a class="" title="${title}" href="${url}">${provinceName}</a></li>`;
        });

        container.innerHTML = html;
    }

    document.addEventListener('DOMContentLoaded', () => {
        renderTodayProvinces();
    });
</script>
