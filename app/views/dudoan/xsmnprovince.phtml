<script>
    // Schedule for XSMN provinces
    const SCHEDULE_MN = {
        1: ["Cà Mau", "Hồ Chí Minh", "Đồng Tháp"],
        2: ["Bạc Liêu", "Bến Tre", "Vũng Tàu"],
        3: ["Cần Thơ", "Sóc Trăng", "Đồng Nai"],
        4: ["An Giang", "Bình Thuận", "Tây Ninh"],
        5: ["Bình Dương", "Trà Vinh", "Vĩnh Long"],
        6: ["Bình Phước", "Hậu Giang", "Hồ Chí Minh", "Long An"],
        0: ["Kiên Giang", "Tiền Giang", "Đà Lạt"]
    };

    // Province mapping for XSMN
    const PROV_SLUG_MAP = {
        "An Giang": "xsag",
        "Bạc Liêu": "xsblieu",
        "Bến Tre": "xsbtr",
        "Bình Dương": "xsbd",
        "Bình Phước": "xsbp",
        "Bình Thuận": "xsbthuan",
        "Cà Mau": "xscm",
        "Cần Thơ": "xsct",
        "Đà Lạt": "xsdl",
        "Đồng Nai": "xsdn",
        "Đồng Tháp": "xsdthap",
        "Hậu Giang": "xshg",
        "Hồ Chí Minh": "xshcm",
        "Kiên Giang": "xskg",
        "Long An": "xsla",
        "Sóc Trăng": "xsst",
        "Tây Ninh": "xstn",
        "Tiền Giang": "xstg",
        "Trà Vinh": "xstv",
        "Vĩnh Long": "xsvl",
        "Vũng Tàu": "xsvt"
    };

    function createProvinceUrl(provinceName) {
        const provinceSlug = PROV_SLUG_MAP[provinceName];
        if (!provinceSlug) {
            console.warn(`No slug mapping found for province: ${provinceName}`);
            return '#';
        }
        return `/du-doan-${provinceSlug}.html`;
    }

    function renderTodayProvinces() {
        const now = new Date();
        const dayOfWeek = now.getDay();
        const todayProvinces = SCHEDULE_MN[dayOfWeek] || [];

        const container = document.querySelector('.js-province-today');
        if (!container) return;

        let html = '';
        todayProvinces.forEach(provinceName => {
            const url = createProvinceUrl(provinceName);
            const title = `Dự đoán XSMN ${provinceName}`;
            const currentClass = provinceName === '<?= htmlspecialchars($provinceName) ?>' ? ' class="current"' : '';
            html += `<li><a${currentClass} title="${title}" href="${url}"> Dự đoán ${provinceName}</a></li>`;
        });

        container.innerHTML = html;
    }
    document.addEventListener('DOMContentLoaded', function() {
        renderTodayProvinces();
    });
</script>

