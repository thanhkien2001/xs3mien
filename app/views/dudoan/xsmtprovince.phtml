<script>
    // Schedule for XSMT provinces
    const SCHEDULE_MT = {
        1: ["Huế", "Phú Yên"],
        2: ["Đắk Lắk", "Quảng Nam"],
        3: ["Đà Nẵng", "Khánh Hòa"],
        4: ["Bình Định", "Quảng Bình", "Quảng Trị"],
        5: ["Gia Lai", "Ninh Thuận"],
        6: ["Đà Nẵng", "Đắk Nông", "Quảng Ngãi"],
        0: ["Khánh Hòa", "Kon Tum", "Huế"]
    };

    // Province mapping for XSMT
    const PROV_SLUG_MAP = {
        "Huế": "xsh",
        "Phú Yên": "xspy",
        "Đắk Lắk": "xsdlk",
        "Quảng Nam": "xsqn",
        "Đà Nẵng": "xsdng",
        "Khánh Hòa": "xskh",
        "Bình Định": "xsbd",
        "Quảng Bình": "xsqb",
        "Quảng Trị": "xsqt",
        "Gia Lai": "xsgl",
        "Ninh Thuận": "xsnt",
        "Đắk Nông": "xsdnong",
        "Quảng Ngãi": "xsqng",
        "Kon Tum": "xskt"
    };

    function createProvinceUrl(provinceName) {
        const provinceSlug = PROV_SLUG_MAP[provinceName];
        if (!provinceSlug) {
            console.warn(`No slug mapping found for province: ${provinceName}`);
            return '#';
        }
        return `/du-doan-${provinceSlug}.html`;
    }

    function renderTodayProvinces() {
        const now = new Date();
        const dayOfWeek = now.getDay();
        const todayProvinces = SCHEDULE_MT[dayOfWeek] || [];

        const container = document.querySelector('.js-province-today');
        if (!container) return;

        let html = '';
        todayProvinces.forEach(provinceName => {
            const url = createProvinceUrl(provinceName);
            const title = `Dự đoán XSMT ${provinceName}`;
            const currentClass = provinceName === '<?= htmlspecialchars($provinceName) ?>' ? ' class="current"' : '';
            html += `<li><a${currentClass} title="${title}" href="${url}"> Dự đoán ${provinceName}</a></li>`;
        });

        container.innerHTML = html;
    }

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', function() {
        renderTodayProvinces();
    });
</script>

