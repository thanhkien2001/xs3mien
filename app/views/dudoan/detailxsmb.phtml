                                        // Sắp xếp theo ngày giảm dần (mới nhất trước)
                                        usort($specialPrize30Array, function ($a, $b) {
                                            $dateA = is_array($a) ? $a['draw_date'] : $a->draw_date;
                                            $dateB = is_array($b) ? $b['draw_date'] : $b->draw_date;
                                            return strtotime($dateB) - strtotime($dateA);
                                        });

                                        // Nhóm theo tuần (Thứ 2 - Chủ Nhật)
                                        $calendar = [];
                                        foreach ($specialPrize30Array as $result) {
                                            $drawDate = is_array($result) ? $result['draw_date'] : $result->draw_date;
                                            $timestamp = strtotime($drawDate);
                                            $dayOfWeek = (int)date('N', $timestamp); // 1=Thứ 2, 7=Chủ Nhật

                                            // Tính ngày Thứ 2 của tuần này (lùi lại số ngày cần thiết)
                                            // dayOfWeek = 1 (Thứ 2) => lùi 0 ngày
                                            // dayOfWeek = 2 (Thứ 3) => lùi 1 ngày
                                            // dayOfWeek = 7 (Chủ Nhật) => lùi 6 ngày
                                            $daysToSubtract = ($dayOfWeek == 1) ? 0 : ($dayOfWeek - 1);
                                            $mondayTimestamp = $timestamp - ($daysToSubtract * 86400);
                                            $weekKey = date('Y-W', $mondayTimestamp);

                                            if (!isset($calendar[$weekKey])) {
                                                $calendar[$weekKey] = array_fill(1, 7, null);
                                            }
                                            $calendar[$weekKey][$dayOfWeek] = $result;
                                        }

                                        // Sắp xếp các tuần theo thứ tự giảm dần (tuần mới nhất trước)
