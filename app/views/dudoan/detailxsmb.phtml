function h($s)
{
    return htmlspecialchars((string)($s ?? ''), ENT_QUOTES, 'UTF-8');
}
function safeDecode($src)
{
    if ($src === null) return [];
    $s = trim((string)$src);
    $j = json_decode($s, true);
    if (json_last_error() === JSON_ERROR_NONE) {
        $arr = is_array($j) ? $j : [$j];
        $out = [];
        foreach ($arr as $v) {
            if ($v === null) continue;
            $v = trim((string)$v);
            if ($v !== '') $out[] = $v;
        }
        return $out;
    }
    $s = str_replace(['[', ']'], ' ', $s);
    $s = preg_replace('/"{2,}/', '" "', $s);
    $s = str_replace(['"', ',', ';', '|'], ' ', $s);
    $s = preg_replace('/\s+/', ' ', trim($s));
    if ($s === '') return [];
    $parts = explode(' ', $s);

    $out = [];
    foreach ($parts as $p) {
        $p = trim($p);
        if ($p !== '') $out[] = $p;
    }
    return $out;
}
function dayVN($ymd)
{
    if (!$ymd) return '';
    $w = date('N', strtotime($ymd));
    $map = [1 => 'Thứ Hai', 2 => 'Thứ Ba', 3 => 'Thứ Tư', 4 => 'Thứ Năm', 5 => 'Thứ Sáu', 6 => 'Thứ Bảy', 7 => 'Chủ Nhật'];
    return $map[(int)$w] ?? '';
}
function renderSpecial($num)
{
    $num = trim((string)$num);
    if ($num === '') return '';
    $head = substr($num, 0, max(0, strlen($num) - 2));
    $tail = substr($num, -2);
    return $num;
}
