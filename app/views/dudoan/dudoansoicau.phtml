<script>
    document.addEventListener('DOMContentLoaded', function() {
        const loadMoreBtn = document.querySelector('.js-load-readmore-post-item');
        const articleList = document.querySelector('.js-article-listing');
        let isLoading = false;
        let lastId = < ? = $lastId ? > ;
        console.log('Initial lastId:', lastId);

        if (loadMoreBtn) {
            loadMoreBtn.addEventListener('click', function() {
                if (isLoading) return;

                isLoading = true;
                loadMoreBtn.innerHTML = '<span>Đang tải...</span>';
                loadMoreBtn.disabled = true;

                const requestData = {
                    last_id: lastId
                };
                console.log('Sending lastId:', lastId);

                fetch('/dudoan/loadMoreSoiCau', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(requestData)
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.status === 'success' && data.data.length > 0) {
                            data.data.forEach(function(item, index) {
                                const li = document.createElement('li');
                                li.innerHTML = `
                            <a class="util-flex util-shadow-sm util-text-decoration-none util-p-4"
                                href="/du-doan-xo-so-soi-cau-${item.region.toLowerCase()}/${item.slug}"
                                title="${item.title}">
                                <img class="comp-thumb-medium util-float-start util-me-3 util-lazy-load"
                                    src="${item.image_url}"
                                    data-src="${item.image_url || '/img/soicaududoan/xsmb/dudoanxsmb.png'}"
                                    alt="${item.title}">
                                <aside>
                                    <h3 class="util-fs-5-5 util-font-medium util-lh-base">${item.title}</h3>
                                    <p class="util-text-body util-line-clamp-2">${item.content}...</p>
                                </aside>
                            </a>
                        `;
                                articleList.appendChild(li);
                            });
                            lastId = data.lastId;
                            if (!data.hasMore) {
                                loadMoreBtn.style.display = 'none';
                            }
                        } else {
                            loadMoreBtn.style.display = 'none';
                        }
                    })
                    .catch(error => {
                        console.error('Error loading more articles:', error);
                        loadMoreBtn.innerHTML = '<span>Lỗi tải dữ liệu</span>';
                    })
                    .finally(() => {
                        isLoading = false;
                        loadMoreBtn.innerHTML = '<span>Xem thêm</span>';
                        loadMoreBtn.disabled = false;
                    });
            });
        }
    });
</script>
