<script>
    (function() {
        const DOM_CACHE_MB = {
            ulTop: null,
            ulMore: null,
            btnMore: null
        };
        const TEMPLATES_MB = {
            cardLI: (href, title, desc, isFirst) => `<li class="${isFirst ? 'is-first' : ''}">
        <a class="util-flex util-shadow-sm util-text-decoration-none util-p-4" href="${href}" title="${title}">
          <img class="comp-thumb-medium util-float-start util-me-3 util-lazy-load"
               src="${DEFAULT_THUMB}"
               data-src="${FALLBACK_IMG}"
               alt="${title}">
          <aside class="util-flex-grow-1">
            <h3 class="util-fs-5-5 util-font-medium util-lh-base util-mb-2">${title}</h3>
            <p class="util-text-body util-line-clamp-2 util-mb-0" style="min-height: 2.5em;">${desc}</p>
          </aside>
        </a>
      </li>`,
            smallLI: (href, title, desc) => `<li>
        <a class="util-flex util-shadow-sm util-text-decoration-none util-p-4" href="${href}" title="${title}">
          <img class="comp-thumb-medium util-float-start util-me-3 util-lazy-load"
               src="${DEFAULT_THUMB}"
               data-src="${FALLBACK_IMG}"
               alt="${title}">
          <aside class="util-flex-grow-1">
            <h3 class="util-fs-5-5 util-font-medium util-lh-base util-mb-2">${title}</h3>
            <p class="util-text-body util-line-clamp-2 util-mb-0" style="min-height: 2.5em;">${desc}</p>
          </aside>
        </a>
      </li>`
        };

        const pad = n => String(n);
        const vnDate = d => `${pad(d.getDate())}/${pad(d.getMonth()+1)}/${d.getFullYear()}`;
        const slugDate = d => `${pad(d.getDate())}-${pad(d.getMonth()+1)}-${d.getFullYear()}`;
        const slugDateMonth = d => `${pad(d.getDate())}-${pad(d.getMonth()+1)}`;
        const hrefFor = d => `/xsmb-${slugDateMonth(d)}-ket-qua-xo-so-mien-bac-ngay-${slugDate(d)}.html`;
        const titleFor = d => `XSMB ${vnDate(d)} – Kết Quả Xổ Số Miền Bắc Ngày ${vnDate(d)}`;

        const DEFAULT_THUMB = "/img/listxs/kqxsmb.png";
        const FALLBACK_IMG = "/img/listxs/kqxsmb.png";

        function getBaseDateFromURL() {
            const m = location.pathname.match(/\/xsmb-(\d{1,2})-(\d{1,2})-ket-qua-xo-so-mien-bac-ngay-(\d{1,2})-(\d{1,2})-(\d{4})\.html/i);
            if (m) {
                const d = parseInt(m[3], 10),
                    mo = parseInt(m[4], 10),
                    y = parseInt(m[5], 10);
                const dt = new Date(y, mo - 1, d);
                if (!isNaN(dt)) return dt;
            }
            const now = new Date();
            return new Date(now.getFullYear(), now.getMonth(), now.getDate());
        }

        function buildCardLI(dateObj, isFirst = false) {
            const href = hrefFor(dateObj);
            const title = titleFor(dateObj);
            const desc = `XSMB ${vnDate(dateObj)}, Cập nhật kết quả xổ số Miền Bắc ngày ${vnDate(dateObj)} đầy đủ và chính xác nhất được công bố từ hội đồng xổ số kiến thiết Miền Bắc.`;
            return TEMPLATES_MB.cardLI(href, title, desc, isFirst);
        }

        function buildSmallLI(dateObj) {
            const href = hrefFor(dateObj);
            const title = titleFor(dateObj);
            const desc = `XSMB ${vnDate(dateObj)}, kết quả xổ số Miền Bắc công bố chính thức lúc 18h15.`;
            return TEMPLATES_MB.smallLI(href, title, desc);
        }

        function renderInitialArticles() {
            if (!DOM_CACHE_MB.ulTop) return;

            const base = getBaseDateFromURL();
            const html = [];

            // Pre-build all HTML strings
            for (let i = 0; i < 7; i++) {
                const d = new Date(base);
                d.setDate(base.getDate() - i);
                html.push(buildCardLI(d, i === 0));
            }

            // Single DOM update
            DOM_CACHE_MB.ulTop.innerHTML = html.join('');

            const lastRendered = new Date(base);
            lastRendered.setDate(base.getDate() - 6);
            DOM_CACHE_MB.ulTop.dataset.lastDateTs = lastRendered.getTime();
        }

        function setupLoadMore() {
            if (!DOM_CACHE_MB.btnMore || !DOM_CACHE_MB.ulMore || !DOM_CACHE_MB.ulTop) return;

            let isLoading = false;

            function appendMoreChunk() {
                if (isLoading) return;
                isLoading = true;

                const topTs = parseInt(DOM_CACHE_MB.ulTop.dataset.lastDateTs || 'NaN', 10);
                const startDate = isNaN(topTs) ? (function() {
                    const base = getBaseDateFromURL();
                    base.setDate(base.getDate() - 6);
                    return base;
                })() : new Date(topTs);
                const currentTs = parseInt(DOM_CACHE_MB.ulMore.dataset.lastDateTs || startDate.getTime(), 10);
                const current = new Date(currentTs);

                const chunk = [];
                for (let i = 1; i <= 7; i++) {
                    const d = new Date(current);
                    d.setDate(current.getDate() - i);
                    chunk.push(buildSmallLI(d));
                }

                // Single DOM update
                DOM_CACHE_MB.ulMore.insertAdjacentHTML('beforeend', chunk.join(''));

                const newestOld = new Date(current);
                newestOld.setDate(current.getDate() - 7);
                DOM_CACHE_MB.ulMore.dataset.lastDateTs = newestOld.getTime();

                isLoading = false;
            }

            DOM_CACHE_MB.btnMore.addEventListener('click', appendMoreChunk, false);
        }

        document.addEventListener('DOMContentLoaded', () => {
            DOM_CACHE_MB.ulTop = document.querySelector('.js-comp-article-listing');
            DOM_CACHE_MB.ulMore = document.querySelector('.js-wrap-kqxs-inner');
            DOM_CACHE_MB.btnMore = document.querySelector('.js-load-readmore-kqxs');

            renderInitialArticles();
            setupLoadMore();

            if (window.lozad) {
                const observer = lozad();
                observer.observe();
            }
        });
    })();
</script>