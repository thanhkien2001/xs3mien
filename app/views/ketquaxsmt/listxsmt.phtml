        "Quảng Trị": "/ket-qua-xo-so-quang-tri-xsqtri.html",
    };

    const IMG_DEFAULT = "img/listxs/kqxsmt.png";
    const PROV_IMG = {
        "Bình Định": "/img/listxs/xsmt/binhdinh.png",
        "Đà Nẵng": "/img/listxs/xsmt/danang.png",
        "Đắk Lắk": "/img/listxs/xsmt/daklak.png",
        "Đắk Nông": "/img/listxs/xsmt/daknong.png",
        "Gia Lai": "/img/listxs/xsmt/gialai.png",
        "Huế": "/img/listxs/xsmt/hue.png",
        "Khánh Hòa": "/img/listxs/xsmt/khanhhoa.png",
        "Kon Tum": "/img/listxs/xsmt/kontum.png",
        "Ninh Thuận": "/img/listxs/xsmt/ninhthuan.png",
        "Phú Yên": "/img/listxs/xsmt/phuyen.png",
        "Quảng Bình": "/img/listxs/xsmt/quangbinh.png",
        "Quảng Nam": "/img/listxs/xsmt/quangnam.png",
        "Quảng Ngãi": "/img/listxs/xsmt/quangngai.png",
        "Quảng Trị": "/img/listxs/xsmt/quangtri.png"
    };

    const pad2 = n => String(n).padStart(2, "0");

    function formatDayTitle(d) {
        return `${d.getDate()}/${d.getMonth()+1}/${d.getFullYear()}`;
    }

    function makeCombinedHref(d) {
        const dd = d.getDate(),
            mm = d.getMonth() + 1,
            yyyy = d.getFullYear();
        return `/xsmt-${dd}-${mm}-ket-qua-xo-so-mien-trung-ngay-${dd}-${mm}-${yyyy}.html`;
    }

    function getScheduleFor(date) {
        return SCHEDULE_MT[date.getDay()] || [];
    }

    const DOM_CACHE_MT = {
        listEl: null,
        btnMore: null
    };

    const CARD_TEMPLATE = (href, img, title, desc) => `<li>
      <a class="util-flex util-shadow-sm util-text-decoration-none util-p-4" href="${href}" title="${title}">
        <img class="comp-thumb-medium util-float-start util-me-3 util-lazy-load"
             src="${IMG_DEFAULT}" data-src="${img||IMG_DEFAULT}" alt="${title}">
        <aside class="util-flex-grow-1">
          <h3 class="util-fs-5-5 util-font-medium util-lh-base util-mb-2">${title}</h3>
          <p class="util-text-body util-line-clamp-2 util-mb-0" style="min-height: 2.5em;">${desc}</p>
        </aside>
      </a>
    </li>`;

    function cardArticle({
        href,
        img,
        title,
        desc
    }) {
        return CARD_TEMPLATE(href, img, title, desc);
    }

    function renderCombinedItem(container, date) {
        const dateText = formatDayTitle(date);
        const href = makeCombinedHref(date);
        const title = `XSMT ${dateText} – Kết Quả Xổ Số Miền Trung Ngày ${dateText}`;
        const desc = `XSMT ${dateText}, cập nhật kết quả xổ số Miền Trung ngày ${dateText} đầy đủ và chính xác nhất.`;
        const img = "/img/listxs/kqxsmt.png";

        const fragment = document.createDocumentFragment();
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = `<li class="first">${cardArticle({href, img, title, desc})}</li>`;

        while (tempDiv.firstChild) {
            fragment.appendChild(tempDiv.firstChild);
        }
        container.appendChild(fragment);
    }

    function renderProvinceItems(container, date) {
        const dateText = formatDayTitle(date);
        const provs = getScheduleFor(date);

        if (provs.length === 0) return;

        const fragment = document.createDocumentFragment();
        const tempDiv = document.createElement('div');
        let html = '';

        for (let i = 0; i < provs.length; i++) {
            const prov = provs[i];
            const href = PROV_STATIC_URL_MT[prov] || "#";
            const title = `${prov.toUpperCase()} ${dateText} – KQ Xổ Số ${prov} Ngày ${dateText}`;
            const desc = `${prov.toUpperCase()} ${dateText}. KQ xổ số ${prov} ngày ${dateText} cập nhật nhanh và đủ.`;
            const img = PROV_IMG[prov] || IMG_DEFAULT;
            html += cardArticle({
                href,
                img,
                title,
                desc
            });
        }

        tempDiv.innerHTML = html;
        while (tempDiv.firstChild) {
            fragment.appendChild(tempDiv.firstChild);
        }
        container.appendChild(fragment);
    }

    function setupLoadMore() {
        if (!DOM_CACHE_MT.btnMore) return;

        let offset = 1;
        let isLoading = false;

        DOM_CACHE_MT.btnMore.addEventListener("click", () => {
            if (isLoading) return;
            isLoading = true;

            const today = new Date();
            const d = new Date(today.getFullYear(), today.getMonth(), today.getDate() - offset);
            offset++;

            renderCombinedItem(DOM_CACHE_MT.listEl, d);
            renderProvinceItems(DOM_CACHE_MT.listEl, d);

            isLoading = false;
        });
    }

    document.addEventListener("DOMContentLoaded", () => {
        // Cache DOM elements once
        DOM_CACHE_MT.listEl = document.querySelector(".js-article-listing");
        DOM_CACHE_MT.btnMore = document.querySelector(".js-load-readmore-kqxs");

        if (!DOM_CACHE_MT.listEl) return;

        const now = new Date();
        DOM_CACHE_MT.listEl.innerHTML = "";

        renderCombinedItem(DOM_CACHE_MT.listEl, now);
        renderProvinceItems(DOM_CACHE_MT.listEl, now);
        setupLoadMore();
    });
</script>