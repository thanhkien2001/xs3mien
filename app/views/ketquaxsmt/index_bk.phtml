function getProvinceUrl($provinceName)
{
    $urlMap = [
        'Bình Định' => '/ket-qua-xo-so-binh-dinh-xsbdinh',
        'Đà Nẵng' => '/ket-qua-xo-so-da-nang-xsdna',
        'Đắk Lắk' => '/ket-qua-xo-so-dak-lak-xsdlk',
        'Đắk Nông' => '/ket-qua-xo-so-dak-nong-xsdnong',
        'Gia Lai' => '/ket-qua-xo-so-gia-lai-xsgl',
        'Huế' => '/ket-qua-xo-so-hue-xshue',
        'Khánh Hòa' => '/ket-qua-xo-so-khanh-hoa-xskhoa',
        'Kon Tum' => '/ket-qua-xo-so-kon-tum-xskontum',
        'Ninh Thuận' => '/ket-qua-xo-so-ninh-thuan-xsnt',
        'Phú Yên' => '/ket-qua-xo-so-phu-yen-xspy',
        'Quảng Bình' => '/ket-qua-xo-so-quang-binh-xsqb',
        'Quảng Nam' => '/ket-qua-xo-so-quang-nam-xsqn',
        'Quảng Ngãi' => '/ket-qua-xo-so-quang-ngai-xsqng',
        'Quảng Trị' => '/ket-qua-xo-so-quang-tri-xsqtri',
    ];

    return $urlMap[$provinceName] ?? '/ket-qua-xo-so-' . strtolower(str_replace(' ', '-', $provinceName));
}

function printCells($items)
{
    $filteredItems = array_filter($items, function ($value) {
        return $value !== null && $value !== '';
    });

    if (empty($filteredItems)) {
        echo '<span class="util-loading-spinner util-spinner-sm util-text-warning util-fs-6" role="status"></span>';
        return;
    }
    foreach ($filteredItems as $n) {
        echo '<div>' . htmlspecialchars((string)$n, ENT_QUOTES, 'UTF-8') . '</div>';
    }
}
