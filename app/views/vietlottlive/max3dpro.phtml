<script>
    class LiveLottery {
        constructor() {
            this.lastCheck = 0;
            this.pollInterval = 10000;
            this.lotteryType = 'max3dpro';
            this.init();
        }

        init() {
            this.startPolling();
        }

        isDrawTime() {
            const now = new Date();
            const dayOfWeek = now.getDay();
            const hour = now.getHours();
            const minute = now.getMinutes();

            const validDays = [2, 4, 6];

            const timeConfig = {
                start: {
                    hour: 18,
                    minute: 1
                },
                end: {
                    hour: 19,
                    minute: 0
                }
            };

            const currentTime = hour * 60 + minute;
            const startTime = timeConfig.start.hour * 60 + timeConfig.start.minute;
            const endTime = timeConfig.end.hour * 60 + timeConfig.end.minute;

            let validTime;
            if (endTime < startTime) {
                validTime = currentTime >= startTime || currentTime < endTime;
            } else {
                validTime = currentTime >= startTime && currentTime < endTime;
            }

            return validDays.includes(dayOfWeek) && validTime;
        }

        async startPolling() {
            while (true) {
                try {
                    if (this.isDrawTime()) {
                        await this.checkForUpdates();
                        this.updateStatus('Đang theo dõi kết quả...', 'active');
                    } else {
                        this.updateStatus('Chưa đến giờ quay thưởng', 'waiting');
                    }
                    await this.sleep(this.pollInterval);
                } catch (error) {
                    this.updateStatus('Lỗi kết nối', 'error');
                    await this.sleep(this.pollInterval);
                }
            }
        }

        async checkForUpdates() {
            try {
                const result = await window.apiKeyManager.callApi('max3dpro', {
                    last_check: this.lastCheck
                });

                if (result.status === 'updated' && result.data) {
                    this.updateData(result.data);
                    this.lastCheck = result.timestamp;
                } else if (result.status === 'no_data') {
                    this.updateStatus('Chưa có dữ liệu', 'no-data');
                }
            } catch (error) {
                this.updateStatus('Lỗi kết nối', 'error');
            }
        }

        updateData(data) {
            document.getElementById('drawNumber').textContent = data.draw_number || '--';
            document.getElementById('drawDate').textContent = data.draw_date || '--';

            this.updateNumbers('jackpotNumbers', data.jackpot_numbers);
            this.updateNumbers('firstNumbers', data.first_numbers);
            this.updateNumbers('secondNumbers', data.second_numbers);
            this.updateNumbers('thirdNumbers', data.third_numbers);

            if (data.winners) {
                document.getElementById('jackpotWinners').textContent = data.winners.jackpot || '0';
                document.getElementById('firstWinners').textContent = data.winners.first || '0';
                document.getElementById('secondWinners').textContent = data.winners.second || '0';
                document.getElementById('thirdWinners').textContent = data.winners.third || '0';
                document.getElementById('secondaryWinners').textContent = data.winners.secondary || '0';
                document.getElementById('fourthWinners').textContent = data.winners.fourth || '0';
                document.getElementById('fifthWinners').textContent = data.winners.fifth || '0';
                document.getElementById('sixthWinners').textContent = data.winners.sixth || '0';
            }
        }

        updateNumbers(containerId, numbers) {
            const container = document.getElementById(containerId);
            container.innerHTML = '';

            if (numbers) {
                const nums = numbers.split(',');
                nums.forEach((num, index) => {
                    const span = document.createElement('span');
                    if (containerId === 'jackpotNumbers') {
                        span.className = 'layout-col-6 util-fs-2 util-font-bold util-text-pink';
                    } else if (containerId === 'firstNumbers') {
                        span.className = 'layout-col-6 util-fs-4 util-font-bold util-text-orange';
                    } else if (containerId === 'secondNumbers') {
                        span.className = 'layout-col-4 util-fs-4 util-font-bold util-text-green';
                    } else if (containerId === 'thirdNumbers') {
                        span.className = 'layout-col-4 util-fs-4 util-font-bold util-text-blue';
                    }
                    span.textContent = num.trim().padStart(2, '0');
                    container.appendChild(span);
                });
            } else {
                const loadingCount = containerId === 'jackpotNumbers' ? 2 :
                    containerId === 'firstNumbers' ? 2 :
                    containerId === 'secondNumbers' ? 2 : 2;

                for (let i = 0; i < loadingCount; i++) {
                    const span = document.createElement('span');
                    span.className = 'layout-col-6 util-fs-2 util-font-bold util-text-pink loading-ball';
                    span.textContent = '--';
                    container.appendChild(span);
                }
            }
        }

        updateStatus(message, type) {
            const drawDateEl = document.getElementById('drawDate');
            if (drawDateEl) {
                if (type === 'waiting') {
                    drawDateEl.textContent = 'Chưa đến giờ quay thưởng (T3, T5, T7 18h-18h30)';
                    drawDateEl.className = 'util-text-warning';
                } else if (type === 'active') {
                    const today = new Date();
                    const dateStr = today.toLocaleDateString('vi-VN');
                    drawDateEl.textContent = dateStr;
                    drawDateEl.className = 'util-text-warning';
                } else if (type === 'error') {
                    drawDateEl.textContent = 'Lỗi kết nối';
                    drawDateEl.className = 'text-danger';
                }
            }
        }

        sleep(ms) {
            return new Promise(resolve => setTimeout(resolve, ms));
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        new LiveLottery();
    });
</script>