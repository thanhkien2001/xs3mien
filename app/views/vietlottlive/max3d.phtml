<script>
    class LiveLottery {
        constructor() {
            this.lastCheck = 0;
            this.pollInterval = 10000;
            this.lotteryType = 'max3d';
            this.init();
        }

        init() {
            this.startPolling();
        }

        isDrawTime() {
            const now = new Date();
            const dayOfWeek = now.getDay();
            const hour = now.getHours();
            const minute = now.getMinutes();

            const validDays = [1, 4, 5];

            const timeConfig = {
                start: {
                    hour: 18,
                    minute: 1
                },
                end: {
                    hour: 19,
                    minute: 0
                }
            };

            const currentTime = hour * 60 + minute;
            const startTime = timeConfig.start.hour * 60 + timeConfig.start.minute;
            const endTime = timeConfig.end.hour * 60 + timeConfig.end.minute;
            const validTime = currentTime >= startTime && currentTime < endTime;

            return validDays.includes(dayOfWeek) && validTime;
        }

        async startPolling() {
            while (true) {
                try {
                    if (this.isDrawTime()) {
                        await this.checkForUpdates();
                        this.updateStatus('Đang theo dõi kết quả...', 'active');
                    } else {
                        this.updateStatus('Chưa đến giờ quay thưởng', 'waiting');
                    }
                    await this.sleep(this.pollInterval);
                } catch (error) {
                    this.updateStatus('Lỗi kết nối', 'error');
                    await this.sleep(this.pollInterval);
                }
            }
        }

        async checkForUpdates() {
            try {
                const result = await window.apiKeyManager.callApi('max3d', {
                    last_check: this.lastCheck
                });

                if (result.status === 'updated' && result.data) {
                    this.updateData(result.data);
                    this.lastCheck = result.timestamp;
                } else if (result.status === 'no_data') {
                    this.updateStatus('Chưa có dữ liệu', 'no-data');
                }
            } catch (error) {
                this.updateStatus('Lỗi kết nối', 'error');
            }
        }

        updateData(data) {
            document.getElementById('drawNumber').textContent = data.draw_number || '--';
            document.getElementById('drawDate').textContent = data.draw_date || '--';

            this.updateMax3DNumbers('jackpotNumbers', data.jackpot_numbers);
            this.updateMax3DNumbers('firstNumbers', data.first_numbers);
            this.updateMax3DNumbers('secondNumbers', data.second_numbers);
            this.updateMax3DNumbers('thirdNumbers', data.third_numbers);

            this.updateMax3DPlusNumbers('jackpotNumbersPlus', data.winners.jackpot);
            this.updateMax3DPlusNumbers('firstNumbersPlus', data.winners.first);
            this.updateMax3DPlusNumbers('secondNumbersPlus', data.winners.second);
            this.updateMax3DPlusNumbers('thirdNumbersPlus', data.winners.third);

            if (data.winners) {
                document.getElementById('jackpotWinners').textContent = this.extractWinnerCount(data.winners.jackpot);
                document.getElementById('firstWinners').textContent = this.extractWinnerCount(data.winners.first);
                document.getElementById('secondWinners').textContent = this.extractWinnerCount(data.winners.second);
                document.getElementById('thirdWinners').textContent = this.extractWinnerCount(data.winners.third);

                document.getElementById('jackpotWinnersPlus').textContent = this.extractSecondPart(data.winners.jackpot);
                document.getElementById('firstWinnersPlus').textContent = this.extractSecondPart(data.winners.first);
                document.getElementById('secondWinnersPlus').textContent = this.extractSecondPart(data.winners.second);
                document.getElementById('thirdWinnersPlus').textContent = this.extractSecondPart(data.winners.third);
                document.getElementById('fourthWinnersPlus').textContent = this.extractWinnerCount(data.winners.fourth);
                document.getElementById('fifthWinnersPlus').textContent = this.extractWinnerCount(data.winners.fifth);
                document.getElementById('sixthWinnersPlus').textContent = this.extractWinnerCount(data.winners.sixth);
            }
        }

        updateMax3DNumbers(containerId, numbers) {
            const container = document.getElementById(containerId);
            container.innerHTML = '';

            if (numbers) {
                const nums = numbers.split(',');

                let displayNums = [];
                if (containerId === 'jackpotNumbers') {
                    displayNums = nums.slice(0, 2);
                } else if (containerId === 'firstNumbers') {
                    displayNums = nums.slice(0, 4);
                } else if (containerId === 'secondNumbers') {
                    displayNums = nums.slice(0, 6);
                } else if (containerId === 'thirdNumbers') {
                    displayNums = nums.slice(0, 8);
                }

                displayNums.forEach((num, index) => {
                    const span = document.createElement('span');
                    if (containerId === 'jackpotNumbers') {
                        span.className = 'layout-col-6 util-fs-1 util-font-bold util-text-pink';
                    } else if (containerId === 'firstNumbers') {
                        span.className = 'layout-col-6 util-fs-2 util-font-bold util-text-orange';
                    } else if (containerId === 'secondNumbers') {
                        span.className = 'layout-col-6 util-fs-3 util-font-bold util-text-green';
                    } else if (containerId === 'thirdNumbers') {
                        span.className = 'layout-col-6 util-fs-4 util-font-bold util-text-blue';
                    }
                    span.textContent = num.trim().padStart(2, '0');
                    container.appendChild(span);
                });
            } else {
                const loadingCount = containerId === 'jackpotNumbers' ? 2 :
                    containerId === 'firstNumbers' ? 4 :
                    containerId === 'secondNumbers' ? 6 : 8;

                for (let i = 0; i < loadingCount; i++) {
                    const span = document.createElement('span');
                    span.className = 'layout-col-6 util-fs-1 util-font-bold util-text-pink loading-ball';
                    span.textContent = '--';
                    container.appendChild(span);
                }
            }
        }

        updateMax3DPlusNumbers(containerId, winnerData) {
            const container = document.getElementById(containerId);
            if (!container) return;

            container.innerHTML = '';

            if (winnerData) {
                let displayValue = '';

                if (containerId.includes('jackpotNumbersPlus') ||
                    containerId.includes('firstNumbersPlus') ||
                    containerId.includes('secondNumbersPlus') ||
                    containerId.includes('thirdNumbersPlus')) {
                    displayValue = this.extractSecondPart(winnerData);
                } else {
                    displayValue = this.extractWinnerCount(winnerData);
                }

                const span = document.createElement('span');
                if (containerId === 'jackpotNumbersPlus') {
                    span.className = 'layout-col-6 util-fs-1 util-font-bold util-text-pink';
                } else if (containerId === 'firstNumbersPlus') {
                    span.className = 'layout-col-6 util-fs-2 util-font-bold util-text-orange';
                } else if (containerId === 'secondNumbersPlus') {
                    span.className = 'layout-col-6 util-fs-3 util-font-bold util-text-green';
                } else if (containerId === 'thirdNumbersPlus') {
                    span.className = 'layout-col-6 util-fs-4 util-font-bold util-text-blue';
                } else if (containerId === 'fourthNumbersPlus') {
                    span.className = 'layout-col-6 util-fs-5 util-font-bold util-text-purple';
                } else if (containerId === 'fifthNumbersPlus') {
                    span.className = 'layout-col-6 util-fs-6 util-font-bold util-text-indigo';
                } else if (containerId === 'sixthNumbersPlus') {
                    span.className = 'layout-col-6 util-fs-6 util-font-bold util-text-teal';
                }
                span.textContent = displayValue.padStart(2, '0');
                container.appendChild(span);
            }
        }

        updateStatus(message, type) {
            const drawDateEl = document.getElementById('drawDate');
            if (drawDateEl) {
                if (type === 'waiting') {
                    drawDateEl.textContent = 'Chưa đến giờ quay thưởng (T2, T4, T6 18h-18h30)';
                    drawDateEl.className = 'util-text-warning';
                } else if (type === 'active') {
                    const today = new Date();
                    const dateStr = today.toLocaleDateString('vi-VN');
                    drawDateEl.textContent = dateStr;
                    drawDateEl.className = 'util-text-warning';
                } else if (type === 'error') {
                    drawDateEl.textContent = 'Lỗi kết nối';
                    drawDateEl.className = 'text-danger';
                }
            }
        }

        extractWinnerCount(value) {
            if (!value) return '0';
            if (typeof value === 'string') {
                const parts = value.split(',');
                return parts[0] || '0';
            }
            return value.toString();
        }

        extractSecondPart(value) {
            if (!value) return '0';
            if (typeof value === 'string') {
                const parts = value.split(',');
                return parts[1] || '0';
            }
            return '0';
        }

        sleep(ms) {
            return new Promise(resolve => setTimeout(resolve, ms));
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        new LiveLottery();
    });
</script>