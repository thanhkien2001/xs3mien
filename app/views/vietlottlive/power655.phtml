<script>
    class LiveLottery {
        constructor() {
            this.lastCheck = 0;
            this.pollInterval = 10000;
            this.lotteryType = 'power655';
            this.init();
        }

        init() {
            this.startPolling();
        }

        isDrawTime() {
            const now = new Date();
            const dayOfWeek = now.getDay();
            const hour = now.getHours();
            const minute = now.getMinutes();

            const validDays = [2, 4, 6];

            const timeConfig = {
                start: {
                    hour: 18,
                    minute: 1
                },
                end: {
                    hour: 19,
                    minute: 0
                }
            };

            const currentTime = hour * 60 + minute;
            const startTime = timeConfig.start.hour * 60 + timeConfig.start.minute;
            const endTime = timeConfig.end.hour * 60 + timeConfig.end.minute;
            const validTime = currentTime >= startTime && currentTime < endTime;

            return validDays.includes(dayOfWeek) && validTime;
        }

        async startPolling() {
            while (true) {
                try {
                    if (this.isDrawTime()) {
                        await this.checkForUpdates();
                        this.updateStatus('Đang theo dõi kết quả...', 'active');
                    } else {
                        this.updateStatus('Chưa đến giờ quay thưởng', 'waiting');
                    }
                    await this.sleep(this.pollInterval);
                } catch (error) {
                    this.updateStatus('Lỗi kết nối', 'error');
                    await this.sleep(this.pollInterval);
                }
            }
        }

        async checkForUpdates() {
            try {
                const result = await window.apiKeyManager.callApi('power655', {
                    last_check: this.lastCheck
                });

                if (result.status === 'updated' && result.data) {
                    this.updateData(result.data);
                    this.lastCheck = result.timestamp;
                } else if (result.status === 'no_data') {
                    this.updateStatus('Chưa có dữ liệu', 'no-data');
                }
            } catch (error) {
                this.updateStatus('Lỗi kết nối', 'error');
            }
        }

        updateData(data) {

            document.getElementById('drawNumber').textContent = data.draw_number || '--';
            document.getElementById('drawDate').textContent = data.draw_date || '--';


            if (data.numbers) {
                const numbers = data.numbers.split(',');
                const allNumbers = numbers.slice(0, 7);
                const numbersContainer = document.querySelector('.js-result-number');
                numbersContainer.innerHTML = '';

                allNumbers.forEach((num, index) => {
                    const span = document.createElement('span');

                    if (index === 6) {
                        span.className = 'ball green big util-mx-1 ';
                    } else {
                        span.className = 'ball power big util-mx-1';
                    }
                    span.textContent = num.trim().padStart(2, '0');
                    numbersContainer.appendChild(span);
                });
            }


            if (data.winners) {
                document.getElementById('jackpot1Sl').textContent = data.winners.jackpot_1 || '0';
                document.getElementById('jackpot2Sl').textContent = data.winners.jackpot_2 || '0';
                document.getElementById('giaiNhatSl').textContent = data.winners.giai_nhat || '0';
                document.getElementById('giaiNhiSl').textContent = data.winners.giai_nhi || '0';
                document.getElementById('giaiBaSl').textContent = data.winners.giai_ba || '0';
            }

            if (data.prize_values) {
                document.getElementById('jackpot1Amount').textContent = this.formatMoney(data.prize_values.jackpot_1);
                document.getElementById('jackpot2Amount').textContent = this.formatMoney(data.prize_values.jackpot_2);
                document.getElementById('giaiNhatGiaTri').textContent = this.formatMoney(data.prize_values.giai_nhat);
                document.getElementById('giaiNhiGiaTri').textContent = this.formatMoney(data.prize_values.giai_nhi);
                document.getElementById('giaiBaGiaTri').textContent = this.formatMoney(data.prize_values.giai_ba);
            }
        }

        updateStatus(message, type) {

            const drawDateEl = document.getElementById('drawDate');
            if (drawDateEl) {
                if (type === 'waiting') {
                    drawDateEl.textContent = 'Chưa đến giờ quay thưởng (T3, T5, T7 18h-18h30)';
                    drawDateEl.className = 'util-text-warning';
                } else if (type === 'active') {

                    const today = new Date();
                    const dateStr = today.toLocaleDateString('vi-VN');
                    drawDateEl.textContent = dateStr;
                    drawDateEl.className = 'util-text-warning';
                } else if (type === 'error') {
                    drawDateEl.textContent = 'Lỗi kết nối';
                    drawDateEl.className = 'text-danger';
                }
            }
        }

        formatMoney(amount) {
            if (!amount || amount === 0) return '--';
            return new Intl.NumberFormat('vi-VN', {
                style: 'currency',
                currency: 'VND'
            }).format(amount);
        }

        sleep(ms) {
            return new Promise(resolve => setTimeout(resolve, ms));
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        new LiveLottery();
    });
</script>