  <script defer>
    (function () {
      function initDOM() {
        var skeleton = document.getElementById('loading-skeleton');
        var dataContainer = document.getElementById('lottery-data-container');

        if (skeleton && dataContainer) {
          setTimeout(function () {
            skeleton.style.display = 'none';
            dataContainer.style.display = 'block';
            dataContainer.style.opacity = '0';
            dataContainer.style.transition = 'opacity 0.3s ease-in-out';

            dataContainer.offsetHeight;
            dataContainer.style.opacity = '1';
          }, 100);
        }
        try {
          var observer = lozad('.util-lazy-load', {
            loaded: function (el) {
              el.classList.add('util-loaded');
            }
          });
          observer.observe();
        } catch (e) { }

        var tables = document.querySelectorAll('.lottery-table');
        tables.forEach(function (table) {
          table.style.contain = 'layout style paint';
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initDOM);
      } else {
        initDOM();
      }
      window.addEventListener('load', function () {
        var nextPageLink = document.querySelector('.comp-pagination .comp-page-item:last-child a');
        if (nextPageLink && nextPageLink.href !== '#') {
          var link = document.createElement('link');
          link.rel = 'prefetch';
          link.href = nextPageLink.href;
          document.head.appendChild(link);
        }
      });
    })();
  </script>
  <script src="/js/non-blocking.js" defer></script>
