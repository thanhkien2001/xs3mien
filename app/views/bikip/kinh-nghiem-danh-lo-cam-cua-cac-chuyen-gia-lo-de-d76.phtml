                    <div class="new-content text-justify">
                        <div class="mb-3 muc-luc py-3">
                            <legend class="font-16 text-mucluc pt-1 pl-4"><i class="fa fa-bars mr-2"></i>Mục lục
                            </legend>
                            <ol class="text-news-link">
