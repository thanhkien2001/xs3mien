<script>
    (function() {
        var form = document.querySelector('.js-thong-ke-redirect-form');
        if (!form) return;

        // Đảm bảo form submit đến đúng URL hiện tại
        if (!form.action || form.action === '') {
            form.action = window.location.pathname;
