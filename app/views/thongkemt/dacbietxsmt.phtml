function renderSpecialWithLast2(?string $num, ?string $last2): string
{
    $num = (string)$num;
    $last2 = (string)$last2;
    $safeNum = htmlspecialchars($num, ENT_QUOTES, 'UTF-8');
    $safeL2  = htmlspecialchars($last2, ENT_QUOTES, 'UTF-8');

    $digitsOnly = preg_replace('/\D+/', '', $num);
    if (strlen($digitsOnly) >= 2) {
        $head = htmlspecialchars(substr($digitsOnly, 0, -2), ENT_QUOTES, 'UTF-8');
        return $head . "<span class=\"util-text-red\" style=\"font-weight:bold;\">{$safeL2}</span>";
    }
    return "<span class=\"util-text-red\" style=\"font-weight:bold;\">{$safeNum}</span>";
}

$topMaxTimes = 0;
if (!empty($topLast2Rows4)) {
    foreach ($topLast2Rows4 as $row) {
        foreach ($row as $pair) {
            if (isset($pair['times']) && $pair['times'] > $topMaxTimes) $topMaxTimes = (int)$pair['times'];
        }
    }
}
