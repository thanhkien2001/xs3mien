<?php
$sel = function ($a, $b) {
    return ((string)$a === (string)$b) ? 'selected' : '';
};
$esc = function ($s) {
    return htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8');
};

$hlLast2 = function (?string $num) use ($esc) {
    $num = (string)$num;
    $digits = preg_replace('/\D+/', '', $num);
    if ($digits === '') return '';
    $head = $digits;
    $tail2 = substr($digits, -2);
    $head = substr($digits, 0, max(0, strlen($digits) - 2));
    return sprintf(
        '<span class="util-font-bold">%s</span><span class="util-text-red util-font-bold">%s</span>',
        $esc($head),
        $esc($tail2)
    );
};

