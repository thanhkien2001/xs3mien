                                    $firstDayOfWeek = (int) $firstDay->format('w');
                                    $firstDayOfWeek = $firstDayOfWeek === 0 ? 7 : $firstDayOfWeek; // Convert Sunday to 7 (Monday = 1)
                                    $daysInMonth = (int) $today->format('t');

                                    // Get previous month's last days
                                    $prevMonth = clone $firstDay;
                                    $prevMonth->modify('-1 day');
                                    $prevMonthDays = (int) $prevMonth->format('d');

                                    // Calculate start day (Monday = 1)
                                    $startDay = 1 - ($firstDayOfWeek - 1);

                                    $currentDay = $startDay;
                                    for ($week = 0; $week < 6; $week++):
                                    ?>
                                        <tr>
                                            <?php for ($day = 0; $day < 7; $day++): ?>
                                                <?php
                                                $cellDate = null;
                                                $cellYear = $year;
                                                $cellMonth = $month;

                                                if ($currentDay <= 0) {
                                                    // Previous month
                                                    $displayDay = $prevMonthDays + $currentDay;
                                                    $class = 'old day';
                                                    $cellDate = clone $prevMonth;
                                                    $cellDate->setDate((int) $prevMonth->format('Y'), (int) $prevMonth->format('n'), $displayDay);
                                                    $cellYear = (int) $cellDate->format('Y');
                                                    $cellMonth = (int) $cellDate->format('n');
                                                    $timestamp = $cellDate->getTimestamp() * 1000;
                                                } elseif ($currentDay > $daysInMonth) {
                                                    // Next month
                                                    $displayDay = $currentDay - $daysInMonth;
                                                    $class = 'new disabled day';
                                                    $nextMonth = clone $firstDay;
                                                    $nextMonth->modify('+1 month');
                                                    $cellDate = clone $nextMonth;
                                                    $cellDate->setDate((int) $nextMonth->format('Y'), (int) $nextMonth->format('n'), $displayDay);
                                                    $cellYear = (int) $cellDate->format('Y');
                                                    $cellMonth = (int) $cellDate->format('n');
                                                    $timestamp = $cellDate->getTimestamp() * 1000;
                                                } else {
                                                    // Current month
                                                    $displayDay = $currentDay;
                                                    $cellDate = new DateTime("$year-$month-" . str_pad($displayDay, 2, '0', STR_PAD_LEFT));
                                                    $timestamp = $cellDate->getTimestamp() * 1000;

                                                    // Check if date is in the future
                                                    $today = new DateTime();
                                                    $today->setTime(0, 0, 0);
                                                    $cellDate->setTime(0, 0, 0);

                                                    if ($cellDate > $today) {
                                                        $class = 'day disabled';
                                                    } else {
                                                        $class = 'day';
                                                    }
                                                }

                                                // Generate URL for current and past dates only
                                                $url = '';
                                                if ($cellDate && $cellDate <= $today) {
                                                    $url = sprintf('/xsmb-%d-%d-%d.html', $displayDay, $cellMonth, $cellYear);
                                                }

                                                $currentDay++;
