                                    $firstDayOfWeek = $firstDayOfWeek === 0 ? 7 : $firstDayOfWeek; // Convert Sunday to 7 (Monday = 1)
                                    $daysInMonth = (int)$today->format('t');
                                    
                                    // Get previous month's last days
                                    $prevMonth = clone $firstDay;
                                    $prevMonth->modify('-1 day');
                                    $prevMonthDays = (int)$prevMonth->format('d');
                                    
                                    // Calculate start day (Monday = 1)
                                    $startDay = 1 - ($firstDayOfWeek - 1);
                                    
                                    $currentDay = $startDay;
                                    for ($week = 0; $week < 6; $week++):
