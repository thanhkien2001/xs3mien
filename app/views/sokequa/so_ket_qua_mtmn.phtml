                                            <?php
                                            $cellDate = null;
                                            $cellYear = $year;
                                            $cellMonth = $month;
                                            
                                            if ($currentDay <= 0) {
                                                // Previous month
                                                $displayDay = $prevMonthDays + $currentDay;
                                                $class = 'old day';
                                                $cellDate = clone $prevMonth;
                                                $cellDate->setDate((int)$prevMonth->format('Y'), (int)$prevMonth->format('n'), $displayDay);
                                                $cellYear = (int)$cellDate->format('Y');
                                                $cellMonth = (int)$cellDate->format('n');
                                                $timestamp = $cellDate->getTimestamp() * 1000;
                                            } elseif ($currentDay > $daysInMonth) {
                                                // Next month
                                                $displayDay = $currentDay - $daysInMonth;
                                                $class = 'new disabled day';
                                                $nextMonth = clone $firstDay;
                                                $nextMonth->modify('+1 month');
                                                $cellDate = clone $nextMonth;
                                                $cellDate->setDate((int)$nextMonth->format('Y'), (int)$nextMonth->format('n'), $displayDay);
                                                $cellYear = (int)$cellDate->format('Y');
                                                $cellMonth = (int)$cellDate->format('n');
                                                $timestamp = $cellDate->getTimestamp() * 1000;
                                            } else {
                                                // Current month
                                                $displayDay = $currentDay;
                                                $cellDate = new DateTime("$year-$month-" . str_pad($displayDay, 2, '0', STR_PAD_LEFT));
                                                $timestamp = $cellDate->getTimestamp() * 1000;
                                                
                                                // Check if date is in the future
                                                $today = new DateTime();
                                                $today->setTime(0, 0, 0);
                                                $cellDate->setTime(0, 0, 0);
                                                
                                                if ($cellDate > $today) {
                                                    $class = 'day disabled';
                                                } else {
                                                    $class = 'day';
                                                }
