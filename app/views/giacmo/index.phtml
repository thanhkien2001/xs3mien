<script>
document.addEventListener('DOMContentLoaded', function() {
    const btnLoadMore = document.querySelector('.btnLoadMore');
    if (btnLoadMore) {
        btnLoadMore.addEventListener('click', function() {
            const currentPage = parseInt(this.getAttribute('data-page') || '2');
            const baseUrl = this.getAttribute('data-url');
            const total = parseInt(this.getAttribute('data-total') || '0');
            const limit = parseInt(this.getAttribute('data-limit') || '10');
            
            if (!baseUrl) {
                console.error('Missing data-url attribute');
                return;
            }
            
            this.disabled = true;
            const originalText = this.textContent;
            this.textContent = 'Đang tải...';
            
            fetch(baseUrl + currentPage + '.html', {
                method: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.text();
            })
            .then(html => {
                if (html && html.trim().length > 0) {
                    const ajaxContent = document.getElementById('ajax_content');
                    if (ajaxContent) {
                        ajaxContent.insertAdjacentHTML('beforeend', html);
                    }
                    const newPage = currentPage + 1;
                    this.setAttribute('data-page', newPage);
                    if (newPage * limit >= total) {
                        this.style.display = 'none';
                    } else {
                        this.disabled = false;
                        this.textContent = originalText;
                    }
                } else {
                    this.style.display = 'none';
                }
            })
            .catch(error => {
                console.error('Error:', error);
                this.disabled = false;
                this.textContent = originalText;
            });
        });
    }
});
</script>