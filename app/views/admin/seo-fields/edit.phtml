    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function previewSeo() {
            const formData = new FormData();
            formData.append('pageType', '<?= $pageType ?>');
            formData.append('pageSubtype', '<?= $pageSubtype ?>');
            
            // Get current field values
            const fields = document.querySelectorAll('input[name^="fields["], textarea[name^="fields["]');
            fields.forEach(field => {
                formData.append('fields[' + field.name.match(/\[(.*?)\]/)[1] + ']', field.value);
            });
            
            // Sample variables for preview
            const sampleVariables = {
                'regionName': 'Miền Bắc',
                'regionCode': 'XSMB',
                'provinceName': 'Hà Nội',
                'date': '25/12/2024',
                'title': 'Dự đoán số may mắn',
                'weekdayText': 'Thứ Hai',
                'provinceCode': 'xshn'
            };
            
            Object.entries(sampleVariables).forEach(([key, value]) => {
                formData.append('variables[' + key + ']', value);
            });

            fetch('/admin/seo-fields/preview', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const preview = document.getElementById('seo-preview');
                    preview.innerHTML = `
                        <div class="mb-2">
                            <strong>Title:</strong><br>
                            <span class="text-primary">${data.data.title_template || 'N/A'}</span>
                        </div>
                        <div class="mb-2">
                            <strong>Description:</strong><br>
                            <span class="text-secondary">${data.data.description_template || 'N/A'}</span>
                        </div>
                        <div class="mb-2">
                            <strong>Keywords:</strong><br>
                            <span class="text-info">${data.data.keywords_template || 'N/A'}</span>
                        </div>
                    `;
                } else {
                    document.getElementById('seo-preview').innerHTML = 
                        '<p class="text-danger">Error generating preview</p>';
                }
            })
            .catch(error => {
                document.getElementById('seo-preview').innerHTML = 
                    '<p class="text-danger">Error: ' + error.message + '</p>';
            });
        }
    </script>
