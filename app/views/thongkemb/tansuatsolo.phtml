<script>
    // +/- buttons logic
    document.addEventListener('DOMContentLoaded', function() {
        // Range input logic
        const input = document.getElementById('range-day');
        document.getElementById('btn-plus').addEventListener('click', () => {
            let v = parseInt(input.value) || 0;
            input.value = Math.min(100, v + 1);
        });
        document.getElementById('btn-minus').addEventListener('click', () => {
            let v = parseInt(input.value) || 0;
            input.value = Math.max(1, v - 1);
        });

        // Filter Matrix Logic
        const rows = document.querySelectorAll('tr.loto-row');

        // Helper to show/hide rows
        function applyFilter() {
            const checked = [];
            document.querySelectorAll('.loto-checkbox:checked').forEach(cb => checked.push(cb.value));

            rows.forEach(row => {
                const num = row.getAttribute('number');
                row.style.display = checked.includes(num) ? 'table-row' : 'none';
            });
        }

        // Checkbox change event
        document.querySelectorAll('.loto-checkbox').forEach(cb => {
            cb.addEventListener('change', applyFilter);
        });

        // Button Listeners
        document.querySelectorAll('.btn-ts').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const id = this.getAttribute('data-id');
                const num = this.getAttribute('data-number'); // For head/tail buttons

                if (id === 'all_number') {
                    document.querySelectorAll('.loto-checkbox').forEach(cb => cb.checked = true);
                } else if (id === 'all_none') {
                    document.querySelectorAll('.loto-checkbox').forEach(cb => cb.checked = false);
                } else if (id === 'only_even') {
                    document.querySelectorAll('.loto-checkbox').forEach(cb => cb.checked = (parseInt(cb.value) % 2 === 0));
                } else if (id === 'only_odd') {
                    document.querySelectorAll('.loto-checkbox').forEach(cb => cb.checked = (parseInt(cb.value) % 2 !== 0));
                } else if (id === 'head') {
                    // Toggle Head
                    const h = num;
                    document.querySelectorAll('.loto-checkbox').forEach(cb => {
                        if (cb.value.startsWith(h)) cb.checked = !cb.checked;
                    });
                } else if (id === 'tail') {
                    // Toggle Tail
                    const t = num;
                    document.querySelectorAll('.loto-checkbox').forEach(cb => {
                        if (cb.value.endsWith(t)) cb.checked = !cb.checked;
                    });
                }

                applyFilter();
            });
        });
    });
</script>