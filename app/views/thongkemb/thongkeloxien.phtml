<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Filter Matrix Logic (reuse from tansuatsolo)
        const rows = document.querySelectorAll('tr.loto-row');

        function applyFilter() {
            const checked = [];
            document.querySelectorAll('.loto-checkbox:checked').forEach(cb => checked.push(cb.value));
            rows.forEach(row => {
                const num = row.getAttribute('number');
                row.style.display = checked.includes(num) ? 'table-row' : 'none';
            });
        }
        document.querySelectorAll('.loto-checkbox').forEach(cb => cb.addEventListener('change', applyFilter));
        document.querySelectorAll('.btn-ts').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const id = this.getAttribute('data-id');
                const num = this.getAttribute('data-number');
                if (id === 'all_number') document.querySelectorAll('.loto-checkbox').forEach(cb => cb.checked = true);
                else if (id === 'all_none') document.querySelectorAll('.loto-checkbox').forEach(cb => cb.checked = false);
                else if (id === 'only_even') document.querySelectorAll('.loto-checkbox').forEach(cb => cb.checked = (parseInt(cb.value) % 2 === 0));
                else if (id === 'only_odd') document.querySelectorAll('.loto-checkbox').forEach(cb => cb.checked = (parseInt(cb.value) % 2 !== 0));
                else if (id === 'head') document.querySelectorAll('.loto-checkbox').forEach(cb => {
                    if (cb.value.startsWith(num)) cb.checked = !cb.checked;
                });
                else if (id === 'tail') document.querySelectorAll('.loto-checkbox').forEach(cb => {
                    if (cb.value.endsWith(num)) cb.checked = !cb.checked;
                });
                applyFilter();
            });
        });
    });
</script>