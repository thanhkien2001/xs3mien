<?php
// Helper functions
if (!function_exists('h')) {
    function h($s)
    {
        return htmlspecialchars((string)($s ?? ''), ENT_QUOTES, 'UTF-8');
    }
}
if (!function_exists('dmy')) {
    function dmy($d)
    {
        return $d ? date('d/m/Y', strtotime($d)) : '';
    }
}

$asOfDateStr = dmy($asOfDate);

// Organize Head/Tail stats for easy lookup 0-9
$headMap = array_fill(0, 10, 0);
if (!empty($headStats)) {
    foreach ($headStats as $item) $headMap[$item['digit']] = $item['times'];
}
$tailMap = array_fill(0, 10, 0);
if (!empty($tailStats)) {
    foreach ($tailStats as $item) $tailMap[$item['digit']] = $item['times'];
}

// Calculate Sum stats from gridRows
$sumMap = array_fill(0, 10, 0);
if (!empty($gridRows)) {
    foreach ($gridRows as $chunk) {
        foreach ($chunk as $day) {
            $numStr = preg_replace('/\D+/', '', $day['num']);
            if (strlen($numStr) >= 2) {
                $last2 = substr($numStr, -2);
                $d1 = (int)$last2[0];
                $d2 = (int)$last2[1];
                $s = ($d1 + $d2) % 10;
                $sumMap[$s]++;
            }
        }
    }
}
