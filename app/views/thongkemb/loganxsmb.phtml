<script>
    // Handle +/- buttons for range-day input
    $(document).ready(function() {
        $(document).on("click", "#btn-minus", function(e) {
            e.preventDefault();
            let rangeday = parseInt($('#range-day').val()) || 30;
            let min = parseInt($('#range-day').attr('min')) || 1;
            if (rangeday > min) {
                $('#range-day').val(rangeday - 1);
            }
        });

        $(document).on("click", "#btn-plus", function(e) {
            e.preventDefault();
            let rangeday = parseInt($('#range-day').val()) || 30;
            let max = parseInt($('#range-day').attr('max')) || 100;
            if (rangeday < max) {
                $('#range-day').val(rangeday + 1);
            }
        });
    });
</script>