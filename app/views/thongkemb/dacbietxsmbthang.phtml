<script>
    function toggleDigits(mode) {
        const fullSpans = document.querySelectorAll('.full-view');
        fullSpans.forEach(span => {
            span.style.display = (mode == 3) ? 'inline' : 'none';
        });
    }

    // Dropdown toggle logic
    document.addEventListener('click', function(e) {
        const dt = e.target.closest('dt');
        const dd = document.querySelector('.dropdown dd');
        const isSelf = e.target.closest('.dropdown');

        if (dt) {
            dd.style.display = (dd.style.display === 'block') ? 'none' : 'block';
        } else if (!isSelf) {
            if (dd) dd.style.display = 'none';
        }
    });
</script>