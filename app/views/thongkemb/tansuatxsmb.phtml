            <script type="application/json" id="freq-data">
                <?= $freqJSON ?: '{"dates":[],"matrix":{}}' ?>
            </script>

            <script>
                (function() {
                    const elData = document.getElementById('freq-data');
                    let payload = {
                        dates: [],
                        matrix: {}
                    };
                    try {
                        payload = JSON.parse(elData.textContent || '{}');
                    } catch (e) {}

                    const dates = payload.dates || [];
                    const matrix = payload.matrix || {};

                    const table = document.querySelector('.js-freq-table');
                    const thead = table.querySelector('thead');
                    const tbody = table.querySelector('tbody');

                    const fmtVN = d => {
                        if (!/^\d{4}-\d{2}-\d{2}$/.test(d)) return d;
                        const [y, m, dd] = d.split('-');
                        return `${dd}/${m}/${y}`;
                    };

                    const bucket = (v) => {
                        if (v <= 0) return 0;
                        if (v === 1) return 2;
                        if (v === 2) return 3;
                        if (v === 3) return 4;
                        if (v === 4) return 5;
                        if (v === 5) return 6;
                        if (v <= 7) return 7;
                        if (v <= 9) return 8;
                        return 9;
                    };

                    const allNums = [];
                    for (let i = 0; i <= 99; i++) allNums.push(String(i).padStart(2, '0'));

                    const ths = [];
                    ths.push(`<th class="sticky-col corner-cell">Con lô/Tổng</th>`);
                    dates.forEach(d => ths.push(`<th class="sticky-header">${fmtVN(d)}</th>`));
                    thead.innerHTML = `<tr>${ths.join('')}</tr>`;

                    const rowsHTML = [];
                    allNums.forEach(num => {
                        const info = matrix[num] || {
                            by_day: Array(dates.length).fill(0),
                            total: 0,
                            dau: +num[0],
                            duoi: +num[1],
                            type: (+num % 2 === 0 ? 'chan' : 'le')
                        };
                        const cells = [];
                        cells.push(
                            `<td class="sticky-col num-badge" data-num="${num}">
             <span class="num-badge">${num}</span>
             <span class="total-chip" title="Tổng xuất hiện ${num} trong ${dates.length} ngày">${info.total || 0}</span>
           </td>`
                        );
                        for (let i = 0; i < dates.length; i++) {
                            const c = (info.by_day && typeof info.by_day[i] !== 'undefined') ? info.by_day[i] : 0;
                            const b = bucket(c);
                            const zeroCls = c === 0 ? 'count-0' : '';
                            cells.push(`<td class="${zeroCls} hb-${b}" data-c="${c}">${c === 0 ? '0' : c}</td>`);
                        }
                        rowsHTML.push(
                            `<tr class="js-number-row" data-num="${num}" data-dau="${info.dau}" data-duoi="${info.duoi}" data-type="${info.type}">
             ${cells.join('')}
           </tr>`
                        );
                    });
                    tbody.innerHTML = rowsHTML.join('');

                    const selParity = document.querySelector('.js-filter-chan-le');
                    const selHead = document.querySelector('.js-filter-dau');
                    const selTail = document.querySelector('.js-filter-duoi');
                    const chkZero = document.querySelector('.js-toggle-zero');

                    function applyFilters() {
                        const parity = selParity.value;
                        const head = selHead.value;
                        const tail = selTail.value;
                        const hideZero = chkZero.checked;

                        table.querySelectorAll('td.count-0').forEach(td => {
                            if (hideZero) td.classList.add('hidden-zero');
                            else td.classList.remove('hidden-zero');
                        });

                        document.querySelectorAll('.js-number-row').forEach(tr => {
                            const t = tr.getAttribute('data-type');
                            const d = tr.getAttribute('data-dau');
                            const u = tr.getAttribute('data-duoi');

                            let ok = true;
                            if (parity !== 'all' && t !== parity) ok = false;
                            if (head !== 'all' && d !== head) ok = false;
                            if (tail !== 'all' && u !== tail) ok = false;

                            tr.style.display = ok ? '' : 'none';
                        });
                    }

                    selParity.addEventListener('change', applyFilters);
                    selHead.addEventListener('change', applyFilters);
                    selTail.addEventListener('change', applyFilters);
                    chkZero.addEventListener('change', applyFilters);

                    applyFilters();
                })();
            </script>
        </div>
