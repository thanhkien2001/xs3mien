// Helpers
if (!function_exists('h')) {
    function h($s)
    {
        return htmlspecialchars((string)($s ?? ''), ENT_QUOTES, 'UTF-8');
    }
}
if (!function_exists('dmy')) {
    function dmy($d)
    {
        return $d ? date('d-m-Y', strtotime($d)) : '';
    }
}

// Calculate column totals for display
$totalHead = array_fill(0, 10, 0);
if (!empty($perDayHead)) {
    foreach ($perDayHead as $row) {
        foreach ($row['counts'] as $k => $v) $totalHead[$k] += $v;
    }
}

$totalTail = array_fill(0, 10, 0);
