    foreach ($perDayTail as $row) {
        foreach ($row['counts'] as $k => $v) $totalTail[$k] += $v;
    }
}

$totalSum = array_fill(0, 10, 0);
if (!empty($perDaySum)) {
    foreach ($perDaySum as $row) {
        foreach ($row['counts'] as $k => $v) $totalSum[$k] += $v;
    }
}
