<script>
    // Simple script to toggle visibility of stats row based on checkboxes, if desired.
    // The classes tbl_head, tbl_tail, etc. are used.
    document.addEventListener("DOMContentLoaded", function() {
        const checks = {
            'head': '.tbl_head',
            'tail': '.tbl_tail',
            'loto': '.tbl_loto',
            'sum': '.tbl_sum'
        };
        // By default show all? Or hide? The reference view implies checkboxes toggle them.
        // Let's assume they are visible and checkboxes hide/show.
        // Actually typically "check to show" or "check to filter".
        // Let's make them toggle display

        Object.keys(checks).forEach(function(id) {
            const el = document.getElementById(id);
            if (el) {
                el.addEventListener('change', function() {
                    const selector = checks[id];
                    const nodes = document.querySelectorAll(selector);
                    nodes.forEach(n => {
                        n.style.display = this.checked ? 'block' : 'none';
                    });
                });
                // Trigger default: all unchecked -> hidden? Or all checked?
                // View source had values="0". Let's check them by default to show data.
                if (!el.checked) {
                    // If unchecked, hide? Let's verify standard behavior. usually checked = show.
                    // I will check them by default in HTML? No, user source didn't have 'checked'.
                    // But if they are not checked and hidden, the table looks empty.
                    // I'll start with them Visible, and if user unchecks/checks logic applies.
                    // Actually, let's just leave CSS as block.
                    // If I want to implement the toggle:

                    // Force check all by default for better UX
                    el.checked = true;
                }
            }
        });
    });
</script>