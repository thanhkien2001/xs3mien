<script>
    (function() {
        const selChanLe = document.querySelector('.js-filter-chan-le');
        const selDau = document.querySelector('.js-filter-dau');
        const selDuoi = document.querySelector('.js-filter-duoi');
        const rows = document.querySelectorAll('.js-number-row');
        const toggleZero = document.querySelector('.js-toggle-zero');

        function applyFilters() {
            const fCL = selChanLe ? selChanLe.value : 'all';
            const fDau = selDau ? selDau.value : 'all';
            const fDuoi = selDuoi ? selDuoi.value : 'all';
            const hideZero = toggleZero.checked;

            document.querySelectorAll('td.count-0').forEach(td => {
                if (hideZero) td.classList.add('hidden-zero');
                else td.classList.remove('hidden-zero');
            });

            rows.forEach(tr => {
                const type = tr.dataset.typeNum;
                const dau = tr.dataset.dau;
                const duoi = tr.dataset.duoi;

                let ok = true;
                if (fCL !== 'all' && type !== fCL) ok = false;
                if (fDau !== 'all' && dau !== fDau) ok = false;
                if (fDuoi !== 'all' && duoi !== fDuoi) ok = false;

                tr.style.display = ok ? '' : 'none';
            });
        }

        if (selChanLe) selChanLe.addEventListener('change', applyFilters);
        if (selDau) selDau.addEventListener('change', applyFilters);
        if (selDuoi) selDuoi.addEventListener('change', applyFilters);
        if (toggleZero) toggleZero.addEventListener('change', applyFilters);

        applyFilters();
    })();
</script>
