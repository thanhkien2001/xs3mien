<?php
$fmtDateVN = function (?string $ymd): string {
    if (!$ymd || $ymd === '0000-00-00') return '—';
    $dt = DateTime::createFromFormat('Y-m-d', $ymd);
    return $dt ? $dt->format('d/m/Y') : '—';
};
$fmtDateVNShort = function (?string $ymd): string {
    if (!$ymd || $ymd === '0000-00-00') return '—';
    $dt = DateTime::createFromFormat('Y-m-d', $ymd);
    return $dt ? $dt->format('d/m') : '—';
};
$highlightLast2 = function (string $num): string {
    $s = preg_replace('/\D+/', '', $num);
    if ($s === '') $s = '00';
    $last2 = substr(str_pad($s, 2, '0', STR_PAD_LEFT), -2);
    $left  = substr($s, 0, -2);
    return sprintf('%s<span class="util-text-red" style="font-weight:bold;">%s</span>', htmlspecialchars($left), htmlspecialchars($last2));
};
$chunk = function (array $arr, int $size) {
    $out = [];
    $row = [];
    foreach ($arr as $it) {
        $row[] = $it;
        if (count($row) === $size) {
            $out[] = $row;
            $row = [];
        }
    }
    if ($row) $out[] = $row;
    return $out;
};
