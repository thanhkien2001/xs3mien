$chunk2 = function (array $arr): array {
    $out = [];
    for ($i = 0; $i < count($arr); $i += 2) {
        $out[] = array_slice($arr, $i, 2);
    }
    return $out;
};

$fmtDate = function ($ymd) use ($h) {
    if (!$ymd || $ymd === '—') return '—';
    return $h(date('d/m/Y', strtotime($ymd)));
};

