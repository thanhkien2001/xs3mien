    $recentResults = LotteryResults::find([
        'conditions' => 'draw_type = :type:',
        'bind' => ['type' => 'XSMB'],
        'order' => 'draw_date DESC',
        'limit' => 5
    ]);

    $resultsArray = [];
    if ($recentResults && count($recentResults) > 0) {
        foreach ($recentResults as $result) {
            $prizes = [];
            // Sử dụng field names ĐÚNG theo columnMap
            if (isset($result->special_prize) && $result->special_prize) {
                $prizes[1] = is_array($result->special_prize) ? $result->special_prize : \App\Library\KqxsHelper::toArray($result->special_prize);
            }
            if (isset($result->first_prize) && $result->first_prize) {
                $prizes[2] = is_array($result->first_prize) ? $result->first_prize : \App\Library\KqxsHelper::toArray($result->first_prize);
