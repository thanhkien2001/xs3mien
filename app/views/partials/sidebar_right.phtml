            if (isset($result->third_prize) && $result->third_prize) {
                $prizes[4] = is_array($result->third_prize) ? $result->third_prize : \App\Library\KqxsHelper::toArray($result->third_prize);
            }
            if (isset($result->fourth_prize) && $result->fourth_prize) {
                $prizes[5] = is_array($result->fourth_prize) ? $result->fourth_prize : \App\Library\KqxsHelper::toArray($result->fourth_prize);
            }
            if (isset($result->fifth_prize) && $result->fifth_prize) {
                $prizes[6] = is_array($result->fifth_prize) ? $result->fifth_prize : \App\Library\KqxsHelper::toArray($result->fifth_prize);
            }
            if (isset($result->sixth_prize) && $result->sixth_prize) {
                $prizes[7] = is_array($result->sixth_prize) ? $result->sixth_prize : \App\Library\KqxsHelper::toArray($result->sixth_prize);
            }
            if (isset($result->seventh_prize) && $result->seventh_prize) {
                $prizes[8] = is_array($result->seventh_prize) ? $result->seventh_prize : \App\Library\KqxsHelper::toArray($result->seventh_prize);
            }
            if (isset($result->eighth_prize) && $result->eighth_prize) {
                $prizes[9] = is_array($result->eighth_prize) ? $result->eighth_prize : \App\Library\KqxsHelper::toArray($result->eighth_prize);
            }

            if (!empty($prizes)) {
                $resultsArray[] = ['prizes' => $prizes];
            }
        }
    }

    // Debug: Kiểm tra có data không
    $hasData = count($resultsArray) > 0;
    $totalPrizes = 0;
    foreach ($resultsArray as $result) {
        if (isset($result['prizes'])) {
            foreach ($result['prizes'] as $prizes) {
                $totalPrizes += count($prizes);
            }
        }
    }

    $predictions = [
        'loDep' => PredictionHelper::generateLoDep($resultsArray, 10),
        'dacBiet' => PredictionHelper::generateDacBietDep($resultsArray, 10),
        'date' => PredictionHelper::getTomorrowDate(),
        'hasData' => $hasData,
        'totalPrizes' => $totalPrizes, // Debug: tổng số giải
        'resultsCount' => count($resultsArray) // Debug: số kết quả
    ];

    // Cache ngắn hơn nếu không có data
    $cacheTime = $hasData ? 3600 : 300;
    $cache->set($cacheKey, $predictions, $cacheTime);
}
