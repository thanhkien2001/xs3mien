    $dateObj = new \DateTime('now', new \DateTimeZone('Asia/Ho_Chi_Minh'));
    $dow = (int) $dateObj->format('N');

    $provinces = \App\Models\Provinces::find([
        'conditions' => "region = :region: AND FIND_IN_SET(:dow:, draw_days)",
        'bind' => ['region' => $region, 'dow' => (string) $dow],
        'order' => 'id ASC',
    ]);

    // Create fake rows structure for live mode
