// Sidebar Left - Soi cầu và Kết quả XS
use App\Models\PredictionArticles;
use App\Models\Provinces;

// Lấy bài soi cầu mới nhất cho miền Nam và Trung bằng raw SQL để đảm bảo lấy được dữ liệu
$db = $this->getDI()->get('db');

$southQuery = "SELECT pa.slug, p.name as province_name, p.code as province_code
               FROM prediction_articles pa
               JOIN provinces p ON pa.province_id = p.id
               WHERE pa.region = 'XSMN' AND pa.province_id IS NOT NULL
               AND DATE(pa.prediction_date) = CURDATE()
               ORDER BY pa.created_at DESC
               LIMIT 3";

$centralQuery = "SELECT pa.slug, p.name as province_name, p.code as province_code
                 FROM prediction_articles pa
                 JOIN provinces p ON pa.province_id = p.id
                 WHERE pa.region = 'XSMT' AND pa.province_id IS NOT NULL
                 AND DATE(pa.prediction_date) = CURDATE()
                 ORDER BY pa.created_at DESC
                 LIMIT 3";

$southPredictions = $db->query($southQuery)->fetchAll(\Phalcon\Db\Enum::FETCH_ASSOC);
if (empty($southPredictions)) {
    $southQueryFallback = "SELECT pa.slug, p.name as province_name, p.code as province_code
                           FROM prediction_articles pa
                           JOIN provinces p ON pa.province_id = p.id
                           WHERE pa.region = 'XSMN' AND pa.province_id IS NOT NULL
                           ORDER BY pa.prediction_date DESC, pa.created_at DESC
                           LIMIT 3";
    $southPredictions = $db->query($southQueryFallback)->fetchAll(\Phalcon\Db\Enum::FETCH_ASSOC);
}

$centralPredictions = $db->query($centralQuery)->fetchAll(\Phalcon\Db\Enum::FETCH_ASSOC);
if (empty($centralPredictions)) {
    $centralQueryFallback = "SELECT pa.slug, p.name as province_name, p.code as province_code
                             FROM prediction_articles pa
                             JOIN provinces p ON pa.province_id = p.id
                             WHERE pa.region = 'XSMT' AND pa.province_id IS NOT NULL
                             ORDER BY pa.prediction_date DESC, pa.created_at DESC
                             LIMIT 3";
    $centralPredictions = $db->query($centralQueryFallback)->fetchAll(\Phalcon\Db\Enum::FETCH_ASSOC);
}
