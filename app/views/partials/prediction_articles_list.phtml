$currentMinute = (int)$now->format('i');

// Tính toán ngày hiển thị cho Win2888 và dự đoán số đề
// Nếu trước 18h10: hiển thị ngày hiện tại và ngày trước đó
// Nếu sau 18h10: hiển thị ngày tiếp theo và ngày hiện tại
$isAfter1810 = ($currentHour > 18) || ($currentHour == 18 && $currentMinute >= 10);

if ($isAfter1810) {
    // Sau 18h10: ngày tiếp theo và ngày hiện tại
    $date1 = clone $now;
    $date1->modify('+1 day');
    $date2 = clone $now;
} else {
    // Trước 18h10: ngày hiện tại và ngày trước đó
    $date1 = clone $now;
    $date2 = clone $now;
    $date2->modify('-1 day');
}

// Format ngày cho URL (d-m-Y)
$formatDateForUrl = function($dateObj) {
    return $dateObj->format('d-m-Y');
};

// Format ngày cho hiển thị (d/m/Y)
$formatDateForDisplay = function($dateObj) {
    return $dateObj->format('d/m/Y');
};

// Tính thời gian đã qua
$getTimeAgo = function($dateObj) use ($now) {
    if (!$dateObj) {
        return '';
    }
    
    $diff = $now->diff($dateObj);
    $totalSeconds = $now->getTimestamp() - $dateObj->getTimestamp();
    
    // Nếu là ngày trong tương lai hoặc cùng ngày nhưng chưa đến giờ
    if ($totalSeconds < 0) {
        return 'Vừa mới';
    }
    
    $days = floor($totalSeconds / 86400);
    if ($days > 0) {
        return $days . ' ngày trước';
    }
    
    $hours = floor($totalSeconds / 3600);
    if ($hours > 0) {
        return $hours . ' giờ trước';
    }
    
    $minutes = floor($totalSeconds / 60);
    return ($minutes > 0 ? $minutes : 1) . ' phút trước';
};

